<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scenario List View -->
    <record id="view_uat_scenario_list" model="ir.ui.view">
        <field name="name">arabic.government.uat.scenario.list</field>
        <field name="model">arabic.government.uat.scenario</field>
        <field name="arch" type="xml">
            <list string="سيناريوهات اختبار القبول"
                  decoration-success="status == 'pass'"
                  decoration-danger="status == 'fail'"
                  decoration-warning="status == 'blocked'">
                <field name="test_case_id"/>
                <field name="name"/>
                <field name="arabic_module_name"/>
                <field name="category" widget="badge"/>
                <field name="user_role"/>
                <field name="record_ref"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'pass'"
                       decoration-danger="status == 'fail'"
                       decoration-warning="status == 'blocked'"
                       decoration-muted="status == 'pending'"/>
                <field name="batch_reference"/>
            </list>
        </field>
    </record>

    <!-- Scenario Form View -->
    <record id="view_uat_scenario_form" model="ir.ui.view">
        <field name="name">arabic.government.uat.scenario.form</field>
        <field name="model">arabic.government.uat.scenario</field>
        <field name="arch" type="xml">
            <form string="سيناريو اختبار القبول">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,pass,fail,blocked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_field_widget o_field_char">
                            <field name="test_case_id" class="text-muted"/>
                        </span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="التصنيف">
                            <field name="arabic_module_name"/>
                            <field name="category" widget="badge"/>
                            <field name="batch_reference"/>
                            <field name="user_role"/>
                        </group>
                        <group string="السجل المرتبط">
                            <field name="record_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="خطوات الاختبار">
                            <group>
                                <field name="precondition" nolabel="1"
                                       placeholder="الشرط المسبق..."/>
                            </group>
                            <separator string="الخطوات"/>
                            <field name="steps" nolabel="1"
                                   placeholder="خطوات الاختبار..."/>
                            <separator string="النتيجة المتوقعة"/>
                            <field name="expected_result" nolabel="1"
                                   placeholder="النتيجة المتوقعة..."/>
                        </page>
                        <page string="ملاحظات">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Scenario Search View -->
    <record id="view_uat_scenario_search" model="ir.ui.view">
        <field name="name">arabic.government.uat.scenario.search</field>
        <field name="model">arabic.government.uat.scenario</field>
        <field name="arch" type="xml">
            <search string="بحث في سيناريوهات الاختبار">
                <field name="name"/>
                <field name="test_case_id"/>
                <field name="batch_reference"/>
                <field name="record_ref"/>
                <filter string="دفعة UAT-AR-GOV-2026"
                        name="batch_uat" domain="[('batch_reference','=','UAT-AR-GOV-2026')]"/>
                <filter string="معلق" name="pending" domain="[('status','=','pending')]"/>
                <filter string="ناجح" name="pass" domain="[('status','=','pass')]"/>
                <filter string="فاشل" name="fail" domain="[('status','=','fail')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="التصنيف" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="الوحدة" name="group_module" context="{'group_by': 'arabic_module_name'}"/>
                    <filter string="دور المستخدم" name="group_role" context="{'group_by': 'user_role'}"/>
                    <filter string="الحالة" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Scenario Action -->
    <record id="action_uat_scenarios" model="ir.actions.act_window">
        <field name="name">سيناريوهات اختبار القبول</field>
        <field name="res_model">arabic.government.uat.scenario</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uat_scenario_search"/>
        <field name="context">{'search_default_batch_uat': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا توجد سيناريوهات اختبار بعد
            </p>
            <p>استخدم معالج توليد البيانات لإنشاء سيناريوهات اختبار القبول.</p>
        </field>
    </record>
</odoo>
