<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_daftar55_reconcile_alert" model="ir.sequence">
        <field name="name">تسلسل تنبيهات مطابقة دفتر 55</field>
        <field name="code">port_said.daftar55.account.reconcile.alert</field>
        <field name="prefix">D55REC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_daftar55_reconcile_amount_tolerance" model="ir.config_parameter">
        <field name="key">port_said_daftar55_reconcile.amount_tolerance</field>
        <field name="value">1</field>
    </record>

    <record id="param_daftar55_reconcile_date_tolerance_days" model="ir.config_parameter">
        <field name="key">port_said_daftar55_reconcile.date_tolerance_days</field>
        <field name="value">7</field>
    </record>

    <record id="param_daftar55_reconcile_scan_days" model="ir.config_parameter">
        <field name="key">port_said_daftar55_reconcile.scan_days</field>
        <field name="value">60</field>
    </record>

    <record id="ir_cron_daily_daftar55_reconcile_scan" model="ir.cron">
        <field name="name">وكيل مطابقة دفتر 55 - فحص يومي</field>
        <field name="model_id" ref="model_port_said_daftar55_account_reconcile_engine"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily_daftar55_reconcile_scan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
