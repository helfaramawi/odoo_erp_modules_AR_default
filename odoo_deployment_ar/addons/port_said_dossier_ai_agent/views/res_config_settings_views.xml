<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dossier_agent" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dossier.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="وكيل فحص الإضبارة" string="وكيل فحص الإضبارة" name="dossier_ai_agent">
                    <block title="إعدادات وكيل فحص الإضبارة قبل الصرف">
                        <setting string="تفعيل الفحص الذكي لمحتوى المرفقات">
                            <field name="dossier_agent_ai_enabled"/>
                            <div class="text-muted">
                                عند التفعيل سيحاول النظام قراءة نص المرفقات ومطابقته مع بيانات دفتر 55.
                            </div>
                        </setting>
                        <setting string="منع الصرف عند فشل الفحص الذكي">
                            <field name="dossier_agent_ai_strict"/>
                            <div class="text-muted">
                                إذا لم يتم التفعيل، سيتم تسجيل التحذير فقط. نقص المرفقات يمنع الصرف دائماً.
                            </div>
                        </setting>
                        <setting string="منع الصرف إذا تعذر قراءة المرفق">
                            <field name="dossier_agent_block_unreadable"/>
                        </setting>
                        <setting string="حقول مرجع أمر التوريد المحتملة">
                            <field name="dossier_agent_reference_fields"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
