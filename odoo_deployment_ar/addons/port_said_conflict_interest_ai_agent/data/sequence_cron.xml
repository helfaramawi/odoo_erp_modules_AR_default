<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_conflict_interest_alert" model="ir.sequence">
        <field name="name">تسلسل تنبيهات تضارب المصالح</field>
        <field name="code">port_said.conflict.interest.alert</field>
        <field name="prefix">COI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="ir_cron_weekly_conflict_interest_scan" model="ir.cron">
        <field name="name">وكيل تضارب المصالح - فحص أسبوعي</field>
        <field name="model_id" ref="model_port_said_conflict_interest_engine"/>
        <field name="state">code</field>
        <field name="code">model.cron_weekly_conflict_interest_scan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
