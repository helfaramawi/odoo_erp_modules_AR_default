<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_procurement_legal_compliance" model="ir.sequence">
        <field name="name">تسلسل مراجعة الالتزام القانوني للمشتريات</field>
        <field name="code">port_said.procurement.legal.compliance</field>
        <field name="prefix">PLC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_procurement_legal_block_po_confirmation" model="ir.config_parameter">
        <field name="key">port_said_procurement_legal.block_po_confirmation</field>
        <field name="value">1</field>
    </record>

    <record id="ir_cron_daily_procurement_legal_compliance_scan" model="ir.cron">
        <field name="name">وكيل الالتزام القانوني للمشتريات - فحص يومي</field>
        <field name="model_id" ref="model_port_said_procurement_legal_engine"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily_procurement_legal_compliance_scan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
