<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_port_said_budget_alert" model="ir.sequence">
        <field name="name">تنبيه مراقبة موازنة بورسعيد</field>
        <field name="code">port_said.budget.alert</field>
        <field name="prefix">BALT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_port_said_budget_monitor" model="ir.cron">
        <field name="name">وكيل مراقبة الموازنة - يومي</field>
        <field name="model_id" ref="port_said_budget_planning.model_port_said_budget_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_budget_monitor()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_port_said_budget_weekly_report" model="ir.cron">
        <field name="name">وكيل مراقبة الموازنة - تقرير أسبوعي</field>
        <field name="model_id" ref="port_said_budget_planning.model_port_said_budget_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_budget_weekly_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
