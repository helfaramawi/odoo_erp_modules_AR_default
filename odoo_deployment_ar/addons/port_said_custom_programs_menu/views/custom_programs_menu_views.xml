              name="مجموعة البرامج المخصصة"
              sequence="65"
              groups="base.group_user"/>

    <record id="action_organize_c_menus_server" model="ir.actions.server">
        <field name="name">إعادة تجميع برامج c في القائمة</field>
        <field name="model_id" ref="model_port_said_custom_menu_organizer"/>
        <field name="state">code</field>
        <field name="code">action = env['port_said.custom.menu.organizer'].sudo().action_organize_c_menus()</field>
