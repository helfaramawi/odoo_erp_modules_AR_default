<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_executive_briefing" model="ir.sequence">
        <field name="name">تسلسل الملخص التنفيذي اليومي</field>
        <field name="code">port_said.executive.briefing</field>
        <field name="prefix">EXEC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_executive_briefing_auto_send" model="ir.config_parameter">
        <field name="key">port_said_executive_briefing.auto_send</field>
        <field name="value">1</field>
    </record>

    <record id="ir_cron_daily_executive_briefing" model="ir.cron">
        <field name="name">وكيل الملخص التنفيذي اليومي - 8 صباحًا</field>
        <field name="model_id" ref="model_port_said_executive_briefing_engine"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_and_send_daily_briefing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
