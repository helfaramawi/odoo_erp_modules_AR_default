<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_procurement_splitting_alert" model="ir.sequence">
        <field name="name">تسلسل تنبيهات تجزئة المشتريات</field>
        <field name="code">port_said.procurement.splitting.alert</field>
        <field name="prefix">PSPLIT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_procurement_splitting_threshold" model="ir.config_parameter">
        <field name="key">port_said_procurement_splitting.threshold_amount</field>
        <field name="value">50000</field>
    </record>

    <record id="param_procurement_splitting_near_ratio" model="ir.config_parameter">
        <field name="key">port_said_procurement_splitting.near_threshold_ratio</field>
        <field name="value">0.75</field>
    </record>

    <record id="param_procurement_splitting_window_days" model="ir.config_parameter">
        <field name="key">port_said_procurement_splitting.window_days</field>
        <field name="value">30</field>
    </record>

    <record id="param_procurement_splitting_scan_days" model="ir.config_parameter">
        <field name="key">port_said_procurement_splitting.scan_days</field>
        <field name="value">90</field>
    </record>

    <record id="ir_cron_daily_procurement_splitting_scan" model="ir.cron">
        <field name="name">وكيل تجزئة المشتريات - فحص يومي</field>
        <field name="model_id" ref="model_port_said_procurement_splitting_engine"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily_procurement_splitting_scan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
