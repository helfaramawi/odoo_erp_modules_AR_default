<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- قالب المعاينة -->
  <template id="report_form50_preview_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <div style="direction:rtl; font-family:Amiri,'Noto Naskh Arabic',Arial,sans-serif; padding:20px; page-break-after:always;">
          <h2 style="text-align:center;">استمارة 50 ع.ح — معاينة</h2>
          <table style="width:100%; border-collapse:collapse; font-size:10pt;">
            <tr>
              <td style="width:30%; font-weight:bold; padding:4px;">رقم المسلسل</td>
              <td style="padding:4px;"><t t-esc="o.sequence_number"/></td>
              <td style="width:30%; font-weight:bold; padding:4px;">السنة المالية</td>
              <td style="padding:4px;"><t t-esc="o.fiscal_year"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">المصلحة</td>
              <td style="padding:4px;"><t t-esc="o.department_name"/></td>
              <td style="font-weight:bold; padding:4px;">تاريخ الورود</td>
              <td style="padding:4px;"><t t-esc="o.date_received"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">صاحب الحق</td>
              <td style="padding:4px;"><t t-esc="o.vendor_id.name"/></td>
              <td style="font-weight:bold; padding:4px;">رقم استمارة 50</td>
              <td style="padding:4px;"><t t-esc="o.form50_ref"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">بند الميزانية</td>
              <td style="padding:4px;"><t t-esc="o.budget_line"/></td>
              <td style="font-weight:bold; padding:4px;">نوع العملية</td>
              <td style="padding:4px;"><t t-esc="dict(o._fields['transaction_type'].selection).get(o.transaction_type, '')"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">إجمالي الأصل</td>
              <td style="padding:4px;"><t t-esc="o.amount_gross"/> جنيه</td>
              <td style="font-weight:bold; padding:4px;">إجمالي الاستقطاعات</td>
              <td style="padding:4px;"><t t-esc="o.total_deductions"/> جنيه</td>
            </tr>
            <tr>
              <td style="font-weight:bold; font-size:12pt; padding:4px;">صافي المبلغ</td>
              <td colspan="3" style="font-weight:bold; font-size:12pt; padding:4px;">
                <t t-esc="o.amount_net"/> جنيه — <t t-esc="o.amount_words"/>
              </td>
            </tr>
          </table>
          <t t-if="o.invoice_line_ids">
            <h3 style="margin-top:15px;">بيانات الفواتير</h3>
            <table style="width:100%; border-collapse:collapse; font-size:9pt;">
              <thead>
                <tr style="background:#eee;">
                  <th style="border:1px solid #ccc; padding:3px;">رقم الفاتورة</th>
                  <th style="border:1px solid #ccc; padding:3px;">التاريخ</th>
                  <th style="border:1px solid #ccc; padding:3px;">البيان</th>
                  <th style="border:1px solid #ccc; padding:3px;">جنيه</th>
                  <th style="border:1px solid #ccc; padding:3px;">قرش</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="o.invoice_line_ids" t-as="line">
                  <tr>
                    <td style="border:1px solid #ccc; padding:3px;"><t t-esc="line.invoice_ref"/></td>
                    <td style="border:1px solid #ccc; padding:3px;"><t t-esc="line.invoice_date"/></td>
                    <td style="border:1px solid #ccc; padding:3px;"><t t-esc="line.description"/></td>
                    <td style="border:1px solid #ccc; padding:3px; text-align:center;"><t t-esc="line.amount_pounds"/></td>
                    <td style="border:1px solid #ccc; padding:3px; text-align:center;"><t t-esc="line.amount_piasters"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
          </t>
          <p style="margin-top:20px; font-size:8pt; color:#888;">
            *** نسخة معاينة — غير رسمية ***
            طُبعت بتاريخ: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
          </p>
        </div>
      </t>
    </t>
  </template>

  <!-- قالب الطباعة النهائية -->
  <template id="report_form50_final_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <div style="direction:rtl; font-family:Amiri,'Noto Naskh Arabic',Arial,sans-serif; padding:20px; page-break-after:always; position:relative;">
          <h2 style="text-align:center; border-bottom:2px solid #000; padding-bottom:5px;">
            استمارة 50 ع.ح — الديوان العام محافظة بورسعيد
          </h2>
          <table style="width:100%; border-collapse:collapse; font-size:10pt; margin-top:10px;">
            <tr>
              <td style="width:25%; font-weight:bold; padding:5px; border:1px solid #999;">رقم المسلسل</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.sequence_number"/></td>
              <td style="width:25%; font-weight:bold; padding:5px; border:1px solid #999;">السنة المالية</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.fiscal_year"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">المصلحة / القسم</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.department_name"/> — <t t-esc="o.division_name or ''"/></td>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">تاريخ الورود</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.date_received"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">صاحب الحق</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.vendor_id.name"/></td>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">رقم استمارة 50</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.form50_ref"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">بند الميزانية</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.budget_line"/></td>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">رقم الارتباط</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.commitment_ref or ''"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">البنك</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.bank_name or ''"/></td>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">رقم الحساب</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.bank_account_no or ''"/></td>
            </tr>
          </table>

          <t t-if="o.invoice_line_ids">
            <h3 style="margin-top:12px;">بيانات الفواتير</h3>
            <table style="width:100%; border-collapse:collapse; font-size:9pt;">
              <thead>
                <tr style="background:#ddd;">
                  <th style="border:1px solid #666; padding:4px;">#</th>
                  <th style="border:1px solid #666; padding:4px;">رقم الفاتورة</th>
                  <th style="border:1px solid #666; padding:4px;">التاريخ</th>
                  <th style="border:1px solid #666; padding:4px;">البيان</th>
                  <th style="border:1px solid #666; padding:4px;">جنيه</th>
                  <th style="border:1px solid #666; padding:4px;">قرش</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="o.invoice_line_ids" t-as="line">
                  <tr>
                    <td style="border:1px solid #666; padding:4px; text-align:center;"><t t-esc="line_index + 1"/></td>
                    <td style="border:1px solid #666; padding:4px;"><t t-esc="line.invoice_ref"/></td>
                    <td style="border:1px solid #666; padding:4px;"><t t-esc="line.invoice_date"/></td>
                    <td style="border:1px solid #666; padding:4px;"><t t-esc="line.description"/></td>
                    <td style="border:1px solid #666; padding:4px; text-align:center;"><t t-esc="line.amount_pounds"/></td>
                    <td style="border:1px solid #666; padding:4px; text-align:center;"><t t-esc="line.amount_piasters"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
          </t>

          <table style="width:100%; border-collapse:collapse; font-size:10pt; margin-top:12px;">
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999; width:35%;">إجمالي الأصل</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.amount_gross"/> جنيه</td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">إجمالي الاستقطاعات</td>
              <td style="padding:5px; border:1px solid #999;"><t t-esc="o.total_deductions"/> جنيه</td>
            </tr>
            <tr style="background:#f5f5f5;">
              <td style="font-weight:bold; padding:5px; border:2px solid #333; font-size:12pt;">صافي المبلغ</td>
              <td style="padding:5px; border:2px solid #333; font-size:12pt; font-weight:bold;">
                <t t-esc="o.amount_net"/> جنيه
              </td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:5px; border:1px solid #999;">التفقيط</td>
              <td style="padding:5px; border:1px solid #999; font-style:italic;"><t t-esc="o.amount_words"/></td>
            </tr>
          </table>

          <table style="width:100%; margin-top:20px; font-size:9pt;">
            <tr>
              <td style="text-align:center; border:1px solid #999; padding:8px; width:25%;">
                <strong>مراقب الحسابات</strong><br/>
                <t t-esc="o.auditor_id.name or '........................'"/>
              </td>
              <td style="text-align:center; border:1px solid #999; padding:8px; width:25%;">
                <strong>رئيس الحسابات</strong><br/>
                <t t-esc="o.accounts_head_id.name or '........................'"/>
              </td>
              <td style="text-align:center; border:1px solid #999; padding:8px; width:25%;">
                <strong>رئيس المصلحة</strong><br/>
                <t t-esc="o.section_head_id.name or '........................'"/>
              </td>
              <td style="text-align:center; border:1px solid #999; padding:8px; width:25%;">
                <strong>المراجع</strong><br/>
                <t t-esc="o.reviewer_id.name or '........................'"/>
              </td>
            </tr>
          </table>

          <p style="margin-top:15px; font-size:8pt; color:#555; text-align:center;">
            طُبعت نهائياً — رقم الطباعة: <t t-esc="o.final_print_count"/> |
            بتاريخ: <t t-esc="o.last_printed_at or ''"/> |
            النسخة: <t t-esc="o.official_template_version"/>
          </p>
        </div>
      </t>
    </t>
  </template>
</odoo>
