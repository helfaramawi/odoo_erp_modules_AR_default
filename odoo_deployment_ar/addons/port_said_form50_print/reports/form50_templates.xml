<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- قالب المعاينة -->
  <template id="report_form50_preview_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <div style="direction:rtl; font-family:Amiri,'Noto Naskh Arabic',Arial,sans-serif; padding:20px; page-break-after:always;">
          <h2 style="text-align:center;">استمارة 50 ع.ح — معاينة</h2>
          <table style="width:100%; border-collapse:collapse; font-size:10pt;">
            <tr>
              <td style="width:30%; font-weight:bold; padding:4px;">رقم المسلسل</td>
              <td style="padding:4px;"><t t-esc="o.sequence_number"/></td>
              <td style="width:30%; font-weight:bold; padding:4px;">السنة المالية</td>
              <td style="padding:4px;"><t t-esc="o.fiscal_year"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">المصلحة</td>
              <td style="padding:4px;"><t t-esc="o.department_name"/></td>
              <td style="font-weight:bold; padding:4px;">تاريخ الورود</td>
              <td style="padding:4px;"><t t-esc="o.date_received"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">صاحب الحق</td>
              <td style="padding:4px;"><t t-esc="o.vendor_id.name"/></td>
              <td style="font-weight:bold; padding:4px;">رقم استمارة 50</td>
              <td style="padding:4px;"><t t-esc="o.form50_ref"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">بند الميزانية</td>
              <td style="padding:4px;"><t t-esc="o.budget_line"/></td>
              <td style="font-weight:bold; padding:4px;">نوع العملية</td>
              <td style="padding:4px;"><t t-esc="dict(o._fields['transaction_type'].selection).get(o.transaction_type, '')"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px;">إجمالي الأصل</td>
              <td style="padding:4px;"><t t-esc="o.amount_gross"/> جنيه</td>
              <td style="font-weight:bold; padding:4px;">إجمالي الاستقطاعات</td>
              <td style="padding:4px;"><t t-esc="o.total_deductions"/> جنيه</td>
            </tr>
            <tr>
              <td style="font-weight:bold; font-size:12pt; padding:4px;">صافي المبلغ</td>
              <td colspan="3" style="font-weight:bold; font-size:12pt; padding:4px;">
                <t t-esc="o.amount_net"/> جنيه — <t t-esc="o.amount_words"/>
              </td>
            </tr>
          </table>
          <t t-if="o.invoice_line_ids">
            <h3 style="margin-top:15px;">بيانات الفواتير</h3>
            <table style="width:100%; border-collapse:collapse; font-size:9pt;">
              <thead>
                <tr style="background:#eee;">
                  <th style="border:1px solid #ccc; padding:3px;">رقم الفاتورة</th>
                  <th style="border:1px solid #ccc; padding:3px;">التاريخ</th>
                  <th style="border:1px solid #ccc; padding:3px;">البيان</th>
                  <th style="border:1px solid #ccc; padding:3px;">جنيه</th>
                  <th style="border:1px solid #ccc; padding:3px;">قرش</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="o.invoice_line_ids" t-as="line">
                  <tr>
                    <td style="border:1px solid #ccc; padding:3px;"><t t-esc="line.invoice_ref"/></td>
                    <td style="border:1px solid #ccc; padding:3px;"><t t-esc="line.invoice_date"/></td>
                    <td style="border:1px solid #ccc; padding:3px;"><t t-esc="line.description"/></td>
                    <td style="border:1px solid #ccc; padding:3px; text-align:center;"><t t-esc="line.amount_pounds"/></td>
                    <td style="border:1px solid #ccc; padding:3px; text-align:center;"><t t-esc="line.amount_piasters"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
          </t>
          <p style="margin-top:20px; font-size:8pt; color:#888;">
            *** نسخة معاينة — غير رسمية ***
            طُبعت بتاريخ: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
          </p>
        </div>
      </t>
    </t>
  </template>

  <!-- قالب الطباعة النهائية — WeasyPrint compatible -->
  <template id="report_form50_final_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-set="fields" t-value="o._form50_render_fields()"/>
        <div style="margin:0; padding:0; border:none;">
          <style>
            @page { size: A4 portrait; margin: 0 !important; }
            html, body, main,
            #wrapwrap, .o_web_client,
            .article, .o_report_layout_standard,
            div.article { margin: 0 !important; padding: 0 !important; border: none !important; }
            .form50-page {
              position: relative;
              width: 210mm;
              height: 297mm;
              overflow: hidden;
              page-break-after: always;
              margin: 0 !important;
              padding: 0 !important;
            }
            .form50-bg {
              position: absolute;
              top: 0; left: 0;
              width: 210mm; height: 297mm;
              z-index: 1;
            }
            .form50-field {
              position: absolute;
              z-index: 10;
              font-family: 'Noto Sans Arabic', 'Noto Naskh Arabic', 'DejaVu Sans', Arial, sans-serif;
              direction: rtl;
              white-space: nowrap;
              overflow: hidden;
            }
          </style>
          <div class="form50-page">
            <img class="form50-bg"
                 src="http://127.0.0.1:8069/port_said_form50_print/static/img/form50_bg.png"
                 alt=""/>
            <t t-foreach="fields" t-as="fld">
              <span class="form50-field" t-att-style="fld['style']"><t t-esc="fld['text']"/></span>
            </t>
          </div>
        </div>
      </t>
    </t>
  </template>
</odoo>
