<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Paper format بدون هوامش لاستمارة 50 -->
  <record id="paperformat_form50_nomargin" model="report.paperformat">
    <field name="name">استمارة 50 ع.ح — A4 بدون هوامش</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">0</field>
    <field name="margin_bottom">0</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">96</field>
  </record>

  <record id="action_report_form50_preview" model="ir.actions.report">
    <field name="name">معاينة استمارة 50 ع.ح</field>
    <field name="model">port_said.daftar55</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">port_said_form50_print.report_form50_preview_template</field>
    <field name="report_file">port_said_form50_print.report_form50_preview_template</field>
    <field name="binding_model_id" ref="port_said_daftar55.model_port_said_daftar55"/>
    <field name="binding_type">report</field>
    <field name="attachment_use">False</field>
  </record>

  <record id="action_report_form50_final" model="ir.actions.report">
    <field name="name">طباعة نهائية — استمارة 50 ع.ح</field>
    <field name="model">port_said.daftar55</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">port_said_form50_print.report_form50_final_template</field>
    <field name="report_file">port_said_form50_print.report_form50_final_template</field>
    <field name="binding_model_id" ref="port_said_daftar55.model_port_said_daftar55"/>
    <field name="binding_type">report</field>
    <field name="attachment_use">False</field>
    <field name="paperformat_id" ref="paperformat_form50_nomargin"/>
  </record>
</odoo>
