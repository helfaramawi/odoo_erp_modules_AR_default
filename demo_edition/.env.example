# Demo Edition — environment template.
# Copy to .env and fill in DEMO-ONLY values. Never put a production
# credential, host, or key in this file — the Demo Edition must not be
# able to reach any production system even if misconfigured.

APP_ENV=demo

# --- Database (demo Postgres only; see docker-compose.demo.yml) ---
DEMO_DB_NAME=demo_gov_erp
DEMO_DB_USER=demo_odoo
DEMO_DB_PASSWORD=

# --- Demo user accounts (applied to all demo.* logins by the
#     demo_gov_seed_data post-install hook — see scripts/demo-seed/README.md) ---
DEMO_USERS_PASSWORD=

# --- Networking ---
DEMO_HTTP_PORT=8069

# --- External integrations: always mock/sandbox in the Demo Edition,
#     never real endpoints or keys. Leave blank to run with the
#     integrations disabled (default demo behavior). ---
ETA_INVOICE_API_MODE=mock        # mock | sandbox  (never "live" in Demo Edition)
CREDIT_BUREAU_API_MODE=mock      # mock | sandbox  (never "live" in Demo Edition)

# --- Mail (leave blank to disable outbound email in demo) ---
MAIL_CONNECTION=

# --- Object storage, if you move the Odoo filestore off local disk ---
STORAGE_CONNECTION=
