<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- No category_id: see demo_gov_subsidiary_books/security/security_groups.xml
       for why — sharing a category across independently-defined groups
       made Odoo silently strip every one of them from the demo
       Administrator's group membership. -->
  <record id="group_insurance_user" model="res.groups">
    <field name="name">دفاتر التأمينات — مستخدم</field>
    <field name="category_id"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_insurance_manager" model="res.groups">
    <field name="name">دفاتر التأمينات — مدير</field>
    <field name="category_id"/>
    <field name="implied_ids" eval="[(4, ref('group_insurance_user')), (4, ref('account.group_account_manager'))]"/>
  </record>

  <!-- Without this, nobody — not even the demo Administrator — is ever
       added to group_insurance_manager, so its menus (الفوليوهات،
       الإيداعات، الحركات) stay invisible to every demo user. -->
  <record id="base.user_admin" model="res.users">
    <field name="groups_id" eval="[(4, ref('group_insurance_manager'))]"/>
  </record>
</odoo>
