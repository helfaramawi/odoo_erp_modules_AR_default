<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_form50_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="rec">
        <t t-call="web.external_layout">
          <style>
            .o_report_layout_header, header.o_report_layout_header,
            .o_company_logo, .o_address_name, footer, .o_footer { display:none !important; }
            html, body { margin:0; padding:0; }
            .page { margin:0 !important; padding:0 !important; }
          </style>
          <div class="page"
               style="position:relative; width:210mm; height:297mm; margin:0 auto; padding:0; overflow:hidden; direction:rtl;">
            <!-- ═══ خلفية الاستمارة الرسمية — صورة النموذج الأصلي ═══
                 استبدل هذا الملف بالصورة الرسمية دون تعديل أي كود:
                 demo_gov_form50_print/static/img/form50_bg.png -->
            <img src="/demo_gov_form50_print/static/img/form50_bg.png"
                 style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;"
                 alt="استمارة 50 ع.ح"/>

            <!-- ═══ الحقول المتراكبة — مواضعها محسوبة كنسبة % من أبعاد الصفحة ═══ -->
            <t t-foreach="rec._form50_render_fields()" t-as="f">
              <div t-att-style="f['style']"><t t-esc="f['text']"/></div>
            </t>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
