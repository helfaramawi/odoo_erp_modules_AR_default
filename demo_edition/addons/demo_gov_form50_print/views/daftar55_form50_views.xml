<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_daftar55_form_form50_print" model="ir.ui.view">
    <field name="name">demo_gov.daftar55.form.form50.print</field>
    <field name="model">demo_gov.daftar55</field>
    <field name="inherit_id" ref="demo_gov_daftar55.view_daftar55_form"/>
    <field name="arch" type="xml">

      <!-- أزرار الطباعة الرسمية — بعد زر "طباعة" العادي -->
      <xpath expr="//button[@name='action_print_daftar55']" position="after">
        <button name="action_validate_for_print" string="فحص جاهزية الطباعة" type="object" class="btn-secondary"/>
        <button name="action_print_preview"      string="معاينة استمارة 50"   type="object" class="btn-secondary"/>
        <button name="action_print_final"        string="طباعة نهائية"        type="object" class="btn-success"
                invisible="state not in ('cleared','posted','archived')"
                groups="account.group_account_manager"/>
        <button name="action_open_reprint_wizard" string="إعادة طباعة"        type="object" class="btn-warning"
                invisible="not is_final_printed"
                groups="account.group_account_manager"/>
      </xpath>

      <!-- نوع العملية — يحدد قوالب المرفقات المطلوبة -->
      <xpath expr="//field[@name='form50_ref']" position="after">
        <field name="transaction_type"/>
      </xpath>

      <!-- تبويب بيانات الفواتير + جاهزية الطباعة + الطباعة النهائية -->
      <xpath expr="//field[@name='notes']" position="before">
        <notebook>
          <page string="بيانات الفواتير">
            <field name="invoice_line_ids">
              <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="invoice_ref"/>
                <field name="invoice_date"/>
                <field name="description"/>
                <field name="amount_pounds"/>
                <field name="amount_piasters"/>
                <field name="attachment_id"/>
              </tree>
            </field>
            <group>
              <group string="إجمالي الفواتير">
                <field name="invoices_total_pounds"/>
                <field name="invoices_total_piasters"/>
                <field name="invoices_match_gross" widget="boolean_toggle"/>
              </group>
            </group>
          </page>
          <page string="جاهزية الطباعة">
            <field name="print_readiness_notes" readonly="1" widget="text"/>
            <group>
              <field name="can_final_print" widget="boolean_toggle"/>
              <field name="attachments_complete" widget="boolean_toggle"/>
              <field name="missing_attachments_count"/>
              <field name="required_attachments_info" widget="text"/>
            </group>
          </page>
          <page string="سجل الطباعة النهائية" invisible="not is_final_printed">
            <group>
              <group>
                <field name="final_print_count"/>
                <field name="last_printed_at"/>
                <field name="last_printed_by"/>
              </group>
              <group>
                <field name="official_template_version"/>
                <field name="reprint_reason"/>
              </group>
            </group>
          </page>
        </notebook>
      </xpath>

    </field>
  </record>
</odoo>
