<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_promotion_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.promotion.form</field>
    <field name="model">demo_gov.hr.promotion</field>
    <field name="arch" type="xml">
      <form string="حركة ترقية">
        <header>
          <button name="action_send_to_committee" string="إحالة للجنة الموارد البشرية" type="object" class="btn-primary" invisible="state != 'proposed'"/>
          <button name="action_approve" string="اعتماد" type="object" class="btn-success" invisible="state != 'committee_review'"/>
          <button name="action_reject" string="رفض" type="object" invisible="state != 'committee_review'"/>
          <field name="state" widget="statusbar" statusbar_visible="proposed,committee_review,approved"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="current_grade"/>
              <field name="new_grade"/>
            </group>
            <group>
              <field name="decision_number"/>
              <field name="decision_date"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_promotion_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.promotion.list</field>
    <field name="model">demo_gov.hr.promotion</field>
    <field name="arch" type="xml">
      <tree string="حركات الترقية" decoration-success="state=='approved'" decoration-muted="state=='rejected'">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="current_grade"/>
        <field name="new_grade"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_promotion" model="ir.actions.act_window">
    <field name="name">حركات الترقية</field>
    <field name="res_model">demo_gov.hr.promotion</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
