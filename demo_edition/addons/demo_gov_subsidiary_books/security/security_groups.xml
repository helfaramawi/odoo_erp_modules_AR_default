<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- No category_id on purpose: Odoo treats every res.groups sharing one
       category as a single mutually-exclusive selection (like Sales'
       None/User/Manager radio). These six subsidiary-book modules each
       define their own independent user/manager pair; putting them all
       under the shared base.module_category_accounting_accounting made
       Odoo silently strip every membership down to nothing the moment a
       second module's groups were added to the same user — confirmed
       live: granting demo Administrator into all six wiped every one of
       them, while demo_gov_penalties (a different category) was
       unaffected. -->
  <record id="group_subsidiary_user" model="res.groups">
    <field name="name">دفاتر مساعدة — مستخدم</field>
    <field name="category_id"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_subsidiary_manager" model="res.groups">
    <field name="name">دفاتر مساعدة — مدير</field>
    <field name="category_id"/>
    <field name="implied_ids" eval="[(4, ref('group_subsidiary_user')), (4, ref('account.group_account_manager'))]"/>
  </record>

  <!-- Without this, nobody — not even the demo Administrator — is ever
       added to group_subsidiary_manager, so its menus (الفوليوهات،
       تعريف الدفاتر، تصنيفات الحسابات) stay invisible to every demo user. -->
  <record id="base.user_admin" model="res.users">
    <field name="groups_id" eval="[(4, ref('group_subsidiary_manager'))]"/>
  </record>
</odoo>
