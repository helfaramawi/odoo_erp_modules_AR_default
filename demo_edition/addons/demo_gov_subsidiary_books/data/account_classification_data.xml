<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!--
    تصنيفات الحسابات الافتراضية
    ==============================
    coa_code_prefix يطابق بدايات أكواد الشجرة الحكومية المعتمدة الحالية
    (8 خانات — راجعي demo_gov_coa_fix). القيم دي اتصححت لأن الإصدار
    الأصلي من الملف كان مكتوب على افتراض شجرة قديمة (6 خانات) اختلفت
    فيها معاني نفس البادئات تمامًا عن الشجرة المعتمدة الحالية (مثلاً
    بادئة "21" كانت تعني "ذمم دائنة/موردين" في الافتراض القديم، بينما
    في الشجرة المعتمدة الحالية بادئة "21" هي باب "المصروفات" بالكامل —
    استخدام البادئة القديمة كان هيُسند حسابات المصروفات غلط كحسابات
    جارية دائنة عند الضغط على "إسناد تلقائي بالبادئة").

    البادئات الصحيحة في الشجرة المعتمدة الحالية:
    - 3113 = الحسابات المدينة المتنوعة (تحت 31100000 الأصول المالية) → CUR_DR
    - 4111 = الحسابات الجارية الدائنة (تحت 41100000 الالتزامات) → CUR_CR
    - 91   = الحسابات النظامية المدينة (خارج الميزانية) → MEMO_DR (بدون تغيير)
    - 92   = الحسابات النظامية الدائنة (خارج الميزانية) → MEMO_CR (بدون تغيير)
    - PERSONAL: الشجرة المعتمدة معندهاش باب منفصل بالكود لـ"حسابات
      شخصية بالاسم" (نموذج 29) — التمييز ده بيتم عبر ربط الحساب
      بالشريك/الموظف (partner_id) مش عبر بادئة كود مخصصة، فمفيش بادئة
      تلقائية آمنة لها؛ تُسنَد الحسابات لها يدويًا حسب الحاجة.
  -->

  <record id="classification_current_dr" model="demo_gov.subsidiary.account.classification">
    <field name="name">حسابات جارية مدينة</field>
    <field name="code">CUR_DR</field>
    <field name="sequence">10</field>
    <field name="nature">current</field>
    <field name="natural_side">debit</field>
    <field name="coa_code_prefix">3113</field>
    <field name="description">السلف، المدفوعات المقدمة، العهد المستديمة، الذمم المدينة قصيرة الأجل،
السلف المنصرفة للموظفين، السلف على الحساب الجاري للوحدات الفرعية.
تظهر في دفتر مفردات الحسابات الجارية المدينة (39 ع.ح) والإجمالي (71 مكرر ع.ح).</field>
  </record>

  <record id="classification_current_cr" model="demo_gov.subsidiary.account.classification">
    <field name="name">حسابات جارية دائنة</field>
    <field name="code">CUR_CR</field>
    <field name="sequence">20</field>
    <field name="nature">current</field>
    <field name="natural_side">credit</field>
    <field name="coa_code_prefix">4111</field>
    <field name="description">الذمم الدائنة للموردين والمقاولين، الاستقطاعات قبل التوريد،
الضرائب المستحقة، حسابات الجاري الدائنة للجهات الأخرى، أمانات.
تظهر في دفتر مفردات الحسابات الجارية الدائنة (39 ع.ح) والإجمالي (71 ع.ح).</field>
  </record>

  <record id="classification_memo_dr" model="demo_gov.subsidiary.account.classification">
    <field name="name">حسابات نظامية مدينة</field>
    <field name="code">MEMO_DR</field>
    <field name="sequence">30</field>
    <field name="nature">memo</field>
    <field name="natural_side">debit</field>
    <field name="coa_code_prefix">91</field>
    <field name="description">الارتباطات القائمة، الاعتمادات المخصصة، خطابات الضمان الصادرة،
حسابات نظامية مقابلة للالتزامات. تظهر في دفتر مفردات الحسابات النظامية المدينة
(39 مكرر ع.ح) والإجمالي (78 مكرر ع.ح).</field>
  </record>

  <record id="classification_memo_cr" model="demo_gov.subsidiary.account.classification">
    <field name="name">حسابات نظامية دائنة</field>
    <field name="code">MEMO_CR</field>
    <field name="sequence">40</field>
    <field name="nature">memo</field>
    <field name="natural_side">credit</field>
    <field name="coa_code_prefix">92</field>
    <field name="description">الالتزامات المحتملة، خطابات الضمان المستلمة، التأمينات الواردة،
الكفالات المحصلة. تظهر في دفتر مفردات الحسابات النظامية الدائنة (39 مكرر ع.ح)
والإجمالي (78 مكرر ع.ح).</field>
  </record>

  <record id="classification_personal" model="demo_gov.subsidiary.account.classification">
    <field name="name">حسابات شخصية</field>
    <field name="code">PERSONAL</field>
    <field name="sequence">50</field>
    <field name="nature">personal</field>
    <field name="natural_side">debit</field>
    <field name="coa_code_prefix"></field>
    <field name="description">الحسابات الفرعية للأشخاص بالاسم — موظفون، مستفيدون، أصحاب حقوق،
ذمم مدينة شخصية. تظهر في دفتر الحسابات الشخصية ذو الخانتين (نموذج رقم 29 حسابات).
لا يوجد بادئة كود آمنة للإسناد التلقائي (الشجرة المعتمدة تميّز الحساب الشخصي
بربطه بالشريك/الموظف مش ببادئة كود مخصوصة) — يُسنَد الحساب لهذا التصنيف يدويًا.</field>
  </record>

</odoo>
