<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="rpt_partner_ledger">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-call="web.external_layout">
        <div class="page" style="direction:rtl;font-size:10.5pt;">
<style>.o_company_logo,.o_address_name,.o_report_layout_header,header.o_report_layout_header,.odoo-header,.header-content,footer,.footer,.o_footer{display:none!important;}.page{margin-top:0!important;padding-top:0!important;}body{font-family:Arial,sans-serif;direction:rtl;}</style>
<table style="width:100%;border-collapse:collapse;margin-bottom:8px;border-bottom:2px solid #1F497D;padding-bottom:6px;"><tr><td style="width:78px;text-align:center;">&#160;</td><td style="text-align:center;"><div style="font-size:11pt;color:#666;">جمهورية مصر العربية</div><div style="font-size:14pt;font-weight:bold;color:#1F497D;">المحافظة التجريبية — الديوان العام</div><div style="font-size:11pt;font-weight:bold;color:#333;margin-top:3px;">إدارة الحسابات والشؤون المالية</div></td><td style="width:78px;text-align:center;"><img src="data:image/png;base64," style="width:68px;height:68px;object-fit:contain;"/></td></tr></table>

          <div style="text-align:center;border-top:3px double #1F497D;border-bottom:3px double #1F497D;padding:5px 0;margin-bottom:10px;">
            <span style="font-size:14pt;font-weight:bold;color:#1F497D;">كشف حساب
              <t t-if="doc.partner_type == 'supplier'">الموردين</t>
              <t t-elif="doc.partner_type == 'customer'">العملاء</t>
              <t t-else="">الموردين والعملاء</t>
            </span>
          </div>
          <table style="width:100%;margin-bottom:10px;font-size:10pt;">
            <tr>
              <td style="border:1px solid #000;padding:5px;background:#f5f5f5;font-weight:bold;width:14%;">الفترة</td>
              <td style="border:1px solid #000;padding:5px;width:36%;"><t t-esc="doc.date_from"/> — <t t-esc="doc.date_to"/></td>
              <td style="border:1px solid #000;padding:5px;background:#f5f5f5;font-weight:bold;width:14%;">الجهة</td>
              <td style="border:1px solid #000;padding:5px;width:36%;"><t t-esc="doc.company_id.name"/></td>
            </tr>
          </table>
          <t t-set="rows" t-value="doc._get_partner_ledger_data()"/>
          <table style="width:100%;font-size:9.5pt;margin-bottom:12px;">
            <thead>
              <tr style="background:#1F497D;color:white;">
                <th style="padding:5px;border:1px solid #ccc;width:5%;text-align:center;">#</th>
                <th style="padding:5px;border:1px solid #ccc;width:35%;">اسم الشريك</th>
                <th style="padding:5px;border:1px solid #ccc;width:15%;">الرقم الضريبي</th>
                <th style="padding:5px;border:1px solid #ccc;width:13%;text-align:left;">مدين</th>
                <th style="padding:5px;border:1px solid #ccc;width:13%;text-align:left;">دائن</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;text-align:left;">الرصيد</th>
                <th style="padding:5px;border:1px solid #ccc;width:9%;text-align:center;">طبيعة</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="rows" t-as="row">
                <tr t-attf-style="background:{{ '#f9f9f9' if row_index % 2 == 0 else 'white' }};">
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;"><t t-esc="row_index + 1"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-weight:bold;"><t t-esc="row['partner_name']"/></td>
                  <td style="padding:4px;border:1px solid #ddd;"><t t-esc="row['partner_vat'] or '—'"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(row['debit'])"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(row['credit'])"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;font-weight:bold;"
                      t-attf-style="color:{{ '#C00000' if row['balance'] &lt; 0 else '#1F497D' }};">
                    <t t-esc="'%s' % '{:,.2f}'.format(abs(row['balance']))"/>
                  </td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;font-size:8.5pt;font-weight:bold;">
                    <t t-if="row['balance'] &gt; 0"><span style="color:#375623;">مدين</span></t>
                    <t t-elif="row['balance'] &lt; 0"><span style="color:#C00000;">دائن</span></t>
                    <t t-else=""><span style="color:#888;">متوازن</span></t>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot>
              <tr style="background:#1F497D;color:white;font-weight:bold;">
                <td colspan="3" style="padding:5px;border:1px solid #ddd;text-align:center;"><t t-esc="len(rows)"/> شريك</td>
                <td style="padding:5px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(sum(r['debit'] for r in rows))"/></td>
                <td style="padding:5px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(sum(r['credit'] for r in rows))"/></td>
                <td colspan="2" style="padding:5px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(sum(r['balance'] for r in rows))"/></td>
              </tr>
            </tfoot>
          </table>
<table style="width:100%;border-collapse:collapse;margin-top:16px;"><tr><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F497D;">رئيس قسم الحسابات</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والتوقيع</div></td><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F497D;">مدير الشؤون المالية</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والتوقيع</div></td><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F497D;">رئيس الديوان العام</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والختم</div></td></tr></table>
<div style="margin-top:10px;font-size:8pt;color:#555;text-align:center;border-top:1px solid #ccc;padding-top:4px;">Enterprise Solutions Demo — طُبع بتاريخ: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/> — المحافظة التجريبية</div>
        </div>
      </t>
    </t>
  </t>
</template>
</odoo>
