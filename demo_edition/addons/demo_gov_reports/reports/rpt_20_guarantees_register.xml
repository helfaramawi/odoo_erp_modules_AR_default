<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="rpt_guarantees_register_gov">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-call="web.external_layout">
        <div class="page" style="direction:rtl;font-size:10.5pt;">
<style>.o_company_logo,.o_address_name,.o_report_layout_header,header.o_report_layout_header,.odoo-header,.header-content,footer,.footer,.o_footer{display:none!important;}.page{margin-top:0!important;padding-top:0!important;}body{font-family:Arial,sans-serif;direction:rtl;}</style>
<table style="width:100%;border-collapse:collapse;margin-bottom:8px;border-bottom:2px solid #1F497D;padding-bottom:6px;"><tr><td style="width:78px;text-align:center;">&#160;</td><td style="text-align:center;"><div style="font-size:11pt;color:#666;">جمهورية مصر العربية</div><div style="font-size:14pt;font-weight:bold;color:#1F497D;">المحافظة التجريبية — الديوان العام</div><div style="font-size:11pt;font-weight:bold;color:#333;margin-top:3px;">إدارة الحسابات والشؤون المالية</div></td><td style="width:78px;text-align:center;"><img src="data:image/png;base64," style="width:68px;height:68px;object-fit:contain;"/></td></tr></table>

          <div style="text-align:center;border-top:3px double #1F497D;border-bottom:3px double #1F497D;padding:5px 0;margin-bottom:10px;">
            <span style="font-size:14pt;font-weight:bold;color:#1F497D;">سجل خطابات الضمان البنكية السارية</span>
          </div>
          <t t-set="guarantees" t-value="doc._get_guarantees_register_data()"/>
          <table style="width:100%;font-size:9.5pt;margin-bottom:12px;">
            <thead>
              <tr style="background:#1F497D;color:white;">
                <th style="padding:5px;border:1px solid #ccc;width:5%;">#</th>
                <th style="padding:5px;border:1px solid #ccc;width:12%;">رقم الضمان</th>
                <th style="padding:5px;border:1px solid #ccc;width:14%;">النوع</th>
                <th style="padding:5px;border:1px solid #ccc;width:16%;">المورد</th>
                <th style="padding:5px;border:1px solid #ccc;width:12%;">البنك</th>
                <th style="padding:5px;border:1px solid #ccc;width:11%;text-align:left;">القيمة</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;">تاريخ الإصدار</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;">تاريخ الانتهاء</th>
                <th style="padding:5px;border:1px solid #ccc;width:5%;text-align:center;">أيام</th>
                <th style="padding:5px;border:1px solid #ccc;width:5%;text-align:center;">تنبيه</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="guarantees" t-as="bg">
                <tr t-attf-style="background:{{ '#fff3cd' if bg.is_expiring_soon else ('#f9f9f9' if bg_index % 2 == 0 else 'white') }};">
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;"><t t-esc="bg_index + 1"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-weight:bold;"><t t-esc="bg.name"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-size:8.5pt;"><t t-esc="{'preliminary':'ابتدائي','final':'نهائي','advance':'دفعة مقدمة','performance':'حسن تنفيذ','maintenance':'صيانة'}.get(bg.guarantee_type,'')"/></td>
                  <td style="padding:4px;border:1px solid #ddd;"><t t-esc="bg.vendor_id.name if bg.vendor_id else '—'"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-size:8.5pt;"><t t-esc="bg.issuing_bank"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;font-weight:bold;"><t t-esc="'%s' % '{:,.2f}'.format(bg.amount)"/></td>
                  <td style="padding:4px;border:1px solid #ddd;"><t t-esc="bg.issue_date"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-weight:bold;"
                      t-attf-style="color:{{ '#C00000' if bg.is_expiring_soon else 'inherit' }};"><t t-esc="bg.expiry_date"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;"><t t-esc="bg.days_to_expiry"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;">
                    <t t-if="bg.is_expiring_soon"><span style="color:#C55A11;font-weight:bold;">⚠</span></t>
                    <t t-else=""><span style="color:#375623;">✓</span></t>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot>
              <tr style="background:#1F497D;color:white;font-weight:bold;">
                <td colspan="5" style="padding:5px;border:1px solid #ddd;text-align:center;"><t t-esc="len(guarantees)"/> خطاب ضمان</td>
                <td colspan="5" style="padding:5px;border:1px solid #ddd;text-align:left;">إجمالي القيمة: <t t-esc="'%s' % '{:,.2f}'.format(sum(g.amount for g in guarantees))"/> ج.م</td>
              </tr>
            </tfoot>
          </table>
<table style="width:100%;border-collapse:collapse;margin-top:16px;"><tr><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F497D;">رئيس قسم الحسابات</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والتوقيع</div></td><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F497D;">مدير الشؤون المالية</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والتوقيع</div></td><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F497D;">رئيس الديوان العام</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والختم</div></td></tr></table>
<div style="margin-top:10px;font-size:8pt;color:#555;text-align:center;border-top:1px solid #ccc;padding-top:4px;">Enterprise Solutions Demo — طُبع بتاريخ: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/> — المحافظة التجريبية</div>
        </div>
      </t>
    </t>
  </t>
</template>
</odoo>
