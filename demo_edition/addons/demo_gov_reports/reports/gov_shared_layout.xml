<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    ══════════════════════════════════════════════════════════════════════
    SHARED HEADER / FOOTER — الديوان العام للمحافظة التجريبية
    يُستخدم في جميع تقارير الوحدة
    مطابق تماماً لاستمارة 193 ع.ح
    ══════════════════════════════════════════════════════════════════════
-->

<template id="gov_page_style">
<style>
    /* ── إخفاء كل عناصر Odoo الافتراضية ── */
    .o_company_logo          { display:none!important; }
    .o_address_name          { display:none!important; }
    .o_report_layout_header  { display:none!important; }
    header.o_report_layout_header { display:none!important; }
    .odoo-header             { display:none!important; }
    .header-content          { display:none!important; }
    footer                   { display:none!important; }
    .footer                  { display:none!important; }
    .o_footer                { display:none!important; }
    .page { margin-top:0!important; padding-top:0!important; }
    body, .page { font-family:"Cairo","Amiri",Arial,sans-serif; direction:rtl; }
</style>
</template>

<template id="gov_header">
    <!--
        الـ header الرسمي — مطابق لاستمارة 193 ع.ح
        المعاملات:
          - dept_line: اسم الإدارة (مثال: "إدارة الشؤون المالية")
          - doc_number: رقم المستند
          - doc_date: تاريخ المستند
    -->
    <table style="width:100%;border-collapse:collapse;margin-bottom:6px;border-bottom:2px solid #000;padding-bottom:6px;">
        <tr>
            <!-- خانة فارغة يسار (يمين RTL) — محاذاة مع الاستمارة 193 -->
            <td style="width:78px;text-align:center;vertical-align:top;">&#160;</td>

            <!-- النص المركزي -->
            <td style="text-align:center;vertical-align:middle;">
                <div style="font-size:13pt;font-weight:bold;">جمهورية مصر العربية</div>
                <div style="font-size:12pt;font-weight:bold;">المحافظة التجريبية</div>
                <div style="font-size:11pt;">الإدارة العامة للشؤون المالية والإدارية</div>
                <div style="font-size:11pt;font-weight:bold;"><t t-esc="dept_line"/></div>
            </td>

            <!-- شعار المحافظة -->
            <td style="width:78px;text-align:center;vertical-align:middle;">
                <img src="data:image/png;base64,"
                     style="width:70px;height:70px;object-fit:contain;"
                     alt="المحافظة التجريبية"/>
            </td>
        </tr>
    </table>
</template>

<template id="gov_footer">
    <!--
        الـ footer الرسمي — مطابق لاستمارة 193 ع.ح
        المعاملات:
          - report_name_ar: اسم التقرير بالعربية
    -->
    <div style="margin-top:6px;font-size:8pt;color:#555;text-align:center;border-top:1px solid #ccc;padding-top:4px;">
        نظام أوبو إيآر بي — Enterprise Solutions Demo
        طُبع بتاريخ: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
        <t t-esc="report_name_ar"/> — المحافظة التجريبية
    </div>
</template>

</odoo>
