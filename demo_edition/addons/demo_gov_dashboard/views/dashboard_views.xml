<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delete old client action if exists, then create act_url -->
    <delete model="ir.actions.client" search="[('tag','=','demo_gov_dashboard')]"/>

    <record id="action_demo_gov_dashboard_url" model="ir.actions.act_url">
        <field name="name">لوحة القيادة التنفيذية</field>
        <field name="url">/demo_gov/dashboard</field>
        <field name="target">self</field>
    </record>
</odoo>
