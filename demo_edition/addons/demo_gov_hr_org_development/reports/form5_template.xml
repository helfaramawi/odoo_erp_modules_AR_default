<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_form5_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
      <div class="page" style="direction:rtl; font-family:'Amiri','Noto Naskh Arabic',Arial,sans-serif; padding:20px;">
        <h2 style="text-align:center;">استمارة 5 — موازنة الوظائف</h2>
        <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-top:16px;">
          <tr style="background:#eee;">
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">الوظيفة</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">الإدارة</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">السنة المالية</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">الوظائف المعتمدة</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">المشغولة</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">الشاغرة</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">حركات دخول</td>
            <td style="font-weight:bold; padding:4px; border:1px solid #999;">حركات خروج</td>
          </tr>
          <t t-foreach="docs" t-as="o">
            <tr>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.job_id.name"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.department_id.name"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.fiscal_year"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.budgeted_positions"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.filled_positions"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.vacant_positions"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.movements_in"/></td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.movements_out"/></td>
            </tr>
          </t>
        </table>
      </div>
      </t>
    </t>
  </template>
</odoo>
