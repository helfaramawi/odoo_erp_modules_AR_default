<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Without this, the demo Administrator can lack account.group_account_user
       (the exact group this module's own ir.model.access.csv already grants
       access to), and opening the Aging Report wizard fails with an access
       error even though the access rule for this model is correct. -->
  <record id="base.user_admin" model="res.users">
    <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
  </record>
</odoo>
