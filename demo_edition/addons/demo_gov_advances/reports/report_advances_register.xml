<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="rpt_advances_register">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
      <t t-call="web.external_layout">
        <div class="page" style="direction:rtl;font-size:10.5pt;">
<style>.o_company_logo,.o_address_name,.o_report_layout_header,header.o_report_layout_header,.odoo-header,.header-content,footer,.footer,.o_footer{display:none!important;}.page{margin-top:0!important;padding-top:0!important;}body{font-family:Arial,sans-serif;direction:rtl;}</style>
<table style="width:100%;border-collapse:collapse;margin-bottom:8px;border-bottom:2px solid #000;padding-bottom:6px;"><tr><td style="width:78px;text-align:center;vertical-align:top;">&#160;</td><td style="text-align:center;vertical-align:middle;"><div style="font-size:13pt;font-weight:bold;">جمهورية مصر العربية</div><div style="font-size:12pt;font-weight:bold;">الجهة الحكومية التجريبية</div><div style="font-size:11pt;">الإدارة العامة للشؤون المالية والإدارية</div><div style="font-size:11pt;font-weight:bold;">إدارة الحسابات والمالية</div></td><td style="width:78px;text-align:center;vertical-align:middle;"><img src="data:image/png;base64," style="width:68px;height:68px;object-fit:contain;" alt="الجهة الحكومية التجريبية"/></td></tr></table>

          <div style="text-align:center;border-top:3px double #000;border-bottom:3px double #000;padding:5px 0;margin-bottom:10px;">
            <span style="font-size:14pt;font-weight:bold;">سجل السلف الحكومية</span>
          </div>
          <table style="width:100%;font-size:9.5pt;margin-bottom:12px;">
            <thead>
              <tr style="background:#1F3864;color:white;">
                <th style="padding:5px;border:1px solid #ccc;width:5%;text-align:center;">#</th>
                <th style="padding:5px;border:1px solid #ccc;width:12%;">رقم السلفة</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;">التاريخ</th>
                <th style="padding:5px;border:1px solid #ccc;width:12%;">نوع السلفة</th>
                <th style="padding:5px;border:1px solid #ccc;width:18%;">المستفيد</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;text-align:left;">المبلغ</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;text-align:left;">المسوَّى</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;text-align:left;">الرصيد</th>
                <th style="padding:5px;border:1px solid #ccc;width:10%;">الاستحقاق</th>
                <th style="padding:5px;border:1px solid #ccc;width:3%;text-align:center;">الحالة</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="docs" t-as="doc">
                <tr t-attf-style="background:{{ '#ffe0e0' if doc.is_overdue else ('#f9f9f9' if doc_index % 2 == 0 else 'white') }};">
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;"><t t-esc="doc_index + 1"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-weight:bold;"><t t-esc="doc.name"/></td>
                  <td style="padding:4px;border:1px solid #ddd;"><t t-esc="doc.advance_date"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-size:8.5pt;"><t t-esc="{'permanent':'مستديمة','travel':'سفر','transport':'انتقال','vendor':'مقدمة مورد','petty_cash':'نقدية'}.get(doc.advance_type,'')"/></td>
                  <td style="padding:4px;border:1px solid #ddd;"><t t-esc="doc.employee_id.name if doc.employee_id else (doc.vendor_id.name if doc.vendor_id else '')"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;font-weight:bold;"><t t-esc="'%s' % '{:,.2f}'.format(doc.amount)"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(doc.amount_settled or 0)"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:left;font-weight:bold;color:#C00000;"><t t-esc="'%s' % '{:,.2f}'.format(doc.amount_outstanding)"/></td>
                  <td style="padding:4px;border:1px solid #ddd;font-size:8.5pt;"><t t-esc="doc.due_date"/></td>
                  <td style="padding:4px;border:1px solid #ddd;text-align:center;font-size:8pt;font-weight:bold;">
                    <t t-esc="{'draft':'م','submitted':'ت','approved':'ا','disbursed':'ص','settled':'تم','cancelled':'إ'}.get(doc.state,'')"/>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot>
              <tr style="background:#1F3864;color:white;font-weight:bold;">
                <td colspan="5" style="padding:5px;border:1px solid #ddd;text-align:center;">الإجماليات</td>
                <td style="padding:5px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(sum(d.amount for d in docs))"/></td>
                <td style="padding:5px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(sum(d.amount_settled or 0 for d in docs))"/></td>
                <td style="padding:5px;border:1px solid #ddd;text-align:left;"><t t-esc="'%s' % '{:,.2f}'.format(sum(d.amount_outstanding for d in docs))"/></td>
                <td colspan="2" style="padding:5px;border:1px solid #ddd;"/>
              </tr>
            </tfoot>
          </table>
<table style="width:100%;border-collapse:collapse;margin-top:16px;"><tr><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F3864;">رئيس قسم الحسابات</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والتوقيع</div></td><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F3864;">مدير الشؤون المالية</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والتوقيع</div></td><td style="width:33%;text-align:center;padding:10px;border:1px solid #ccc;"><div style="font-weight:bold;color:#1F3864;">رئيس الديوان العام</div><div style="margin-top:20px;border-top:1px solid #999;padding-top:4px;font-size:8pt;">الاسم والختم الرسمي</div></td></tr></table>
<div style="margin-top:10px;font-size:8pt;color:#555;text-align:center;border-top:1px solid #ccc;padding-top:4px;">نظام أوبو إيآر بي — Enterprise Solutions Demo طُبع بتاريخ: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/> — الجهة الحكومية التجريبية</div>
        </div>
      </t>
    </t>
  </t>
</template>
</odoo>
