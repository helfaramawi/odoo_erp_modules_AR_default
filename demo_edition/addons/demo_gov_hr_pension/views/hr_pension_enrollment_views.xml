<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_pension_enrollment_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.pension.enrollment.form</field>
    <field name="model">demo_gov.hr.pension.enrollment</field>
    <field name="arch" type="xml">
      <form string="اشتراك في خطة معاش/تأمين">
        <sheet>
          <group>
            <field name="employee_id"/>
            <field name="plan_id"/>
            <field name="enrollment_date"/>
            <field name="end_date"/>
            <field name="state"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_pension_enrollment_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.pension.enrollment.list</field>
    <field name="model">demo_gov.hr.pension.enrollment</field>
    <field name="arch" type="xml">
      <tree string="اشتراكات المعاشات والتأمينات" editable="bottom" decoration-muted="state=='ended'">
        <field name="employee_id"/>
        <field name="plan_id"/>
        <field name="enrollment_date"/>
        <field name="end_date"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_pension_enrollment" model="ir.actions.act_window">
    <field name="name">اشتراكات المعاشات والتأمينات</field>
    <field name="res_model">demo_gov.hr.pension.enrollment</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
