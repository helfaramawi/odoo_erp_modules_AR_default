<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ══ المدربون ══════════════════════════════════════════════════════ -->
  <record id="view_hr_training_instructor_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.instructor.form</field>
    <field name="model">demo_gov.hr.training.instructor</field>
    <field name="arch" type="xml">
      <form string="مدرب">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="instructor_type"/>
              <field name="specialization"/>
              <field name="employee_id" invisible="instructor_type != 'internal'"/>
            </group>
            <group>
              <field name="phone"/>
              <field name="email"/>
            </group>
          </group>
          <field name="notes" placeholder="ملاحظات..."/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_training_instructor_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.instructor.list</field>
    <field name="model">demo_gov.hr.training.instructor</field>
    <field name="arch" type="xml">
      <tree string="المدربون">
        <field name="name"/>
        <field name="instructor_type"/>
        <field name="specialization"/>
        <field name="phone"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_training_instructor" model="ir.actions.act_window">
    <field name="name">المدربون</field>
    <field name="res_model">demo_gov.hr.training.instructor</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- ══ الدورات التدريبية ═════════════════════════════════════════════ -->
  <record id="view_hr_training_course_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.course.form</field>
    <field name="model">demo_gov.hr.training.course</field>
    <field name="arch" type="xml">
      <form string="دورة تدريبية">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="%(action_hr_training_registration)d" type="action"
                    class="oe_stat_button" icon="fa-users"
                    context="{'default_course_id': id, 'search_default_course_id': id}">
              <field name="registration_count" widget="statinfo" string="المسجَّلون"/>
            </button>
          </div>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="course_type"/>
              <field name="instructor_id"/>
              <field name="location"/>
            </group>
            <group>
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="seats"/>
            </group>
          </group>
          <field name="description" placeholder="وصف الدورة..."/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_training_course_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.course.list</field>
    <field name="model">demo_gov.hr.training.course</field>
    <field name="arch" type="xml">
      <tree string="الدورات التدريبية">
        <field name="name"/>
        <field name="course_type"/>
        <field name="instructor_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="registration_count"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_training_course" model="ir.actions.act_window">
    <field name="name">الدورات التدريبية</field>
    <field name="res_model">demo_gov.hr.training.course</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- ══ الاحتياجات التدريبية ══════════════════════════════════════════ -->
  <record id="view_hr_training_need_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.need.form</field>
    <field name="model">demo_gov.hr.training.need</field>
    <field name="arch" type="xml">
      <form string="احتياج تدريبي">
        <header>
          <button name="action_submit" string="تقديم" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" string="اعتماد" type="object" class="btn-success" invisible="state != 'submitted'"/>
          <button name="action_reject" string="رفض" type="object" invisible="state != 'submitted'"/>
          <button name="action_add_to_plan" string="إدراج في الخطة" type="object" class="btn-primary" invisible="state != 'approved'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,planned"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="department_id"/>
              <field name="priority"/>
            </group>
            <group>
              <field name="fiscal_year"/>
              <field name="requested_by" readonly="1"/>
            </group>
          </group>
          <field name="notes" placeholder="تفاصيل الاحتياج..."/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_training_need_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.need.list</field>
    <field name="model">demo_gov.hr.training.need</field>
    <field name="arch" type="xml">
      <tree string="الاحتياجات التدريبية" decoration-success="state=='planned'" decoration-muted="state=='rejected'">
        <field name="name"/>
        <field name="department_id"/>
        <field name="employee_id"/>
        <field name="priority"/>
        <field name="fiscal_year"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_training_need" model="ir.actions.act_window">
    <field name="name">الاحتياجات التدريبية</field>
    <field name="res_model">demo_gov.hr.training.need</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_this_year': 1}</field>
  </record>

  <!-- ══ تسجيلات الدورات ═══════════════════════════════════════════════ -->
  <record id="view_hr_training_registration_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.registration.form</field>
    <field name="model">demo_gov.hr.training.registration</field>
    <field name="arch" type="xml">
      <form string="تسجيل تدريبي">
        <header>
          <button name="action_request" string="طلب" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_manager_approve" string="اعتماد المدير" type="object" class="btn-primary" invisible="state != 'requested'"/>
          <button name="action_confirm_by_training_dept" string="تأكيد قسم التدريب" type="object" class="btn-primary" invisible="state != 'manager_approved'"/>
          <button name="action_complete" string="إتمام الدورة" type="object" class="btn-success" invisible="state != 'confirmed'"/>
          <button name="action_cancel" string="إلغاء" type="object" invisible="state in ('completed','cancelled')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,requested,manager_approved,confirmed,completed"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="course_id"/>
              <field name="employee_id"/>
              <field name="manager_id" readonly="1"/>
            </group>
          </group>
          <group string="قياس أثر التدريب" invisible="state != 'completed'">
            <group>
              <field name="performance_before"/>
              <field name="performance_after"/>
            </group>
            <group>
              <field name="impact_notes"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_training_registration_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.training.registration.list</field>
    <field name="model">demo_gov.hr.training.registration</field>
    <field name="arch" type="xml">
      <tree string="تسجيلات الدورات" decoration-success="state=='completed'" decoration-muted="state=='cancelled'">
        <field name="name"/>
        <field name="course_id"/>
        <field name="employee_id"/>
        <field name="manager_id"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_training_registration" model="ir.actions.act_window">
    <field name="name">تسجيلات الدورات</field>
    <field name="res_model">demo_gov.hr.training.registration</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
