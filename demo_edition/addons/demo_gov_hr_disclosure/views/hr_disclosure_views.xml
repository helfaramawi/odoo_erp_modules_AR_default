<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_disclosure_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.disclosure.form</field>
    <field name="model">demo_gov.hr.disclosure</field>
    <field name="arch" type="xml">
      <form string="إقرار ذمة مالية">
        <header>
          <button name="action_notify_employee" string="إشعار الموظف" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_submit" string="تقديم الإقرار" type="object" class="btn-primary" invisible="state not in ('draft','notified')"/>
          <button name="action_approve" string="اعتماد وأرشفة" type="object" class="btn-success" invisible="state != 'submitted'"/>
          <button name="action_reject_correction" string="طلب تصحيح" type="object" invisible="state != 'submitted'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,notified,submitted,approved"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="employee_id"/></h1></div>
          <group>
            <group>
              <field name="disclosure_type"/>
              <field name="declaration_date"/>
              <field name="renewal_due_date" readonly="1"/>
              <field name="next_renewal_date" readonly="1"/>
            </group>
            <group>
              <field name="reviewed_by" readonly="1"/>
              <field name="review_date" readonly="1"/>
            </group>
          </group>
          <group string="بيانات الإقرار">
            <group>
              <field name="real_estate_value"/>
              <field name="vehicle_value"/>
              <field name="bank_deposits"/>
            </group>
            <group>
              <field name="other_assets"/>
              <field name="liabilities"/>
              <field name="net_worth" readonly="1"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_disclosure_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.disclosure.list</field>
    <field name="model">demo_gov.hr.disclosure</field>
    <field name="arch" type="xml">
      <tree string="إقرارات الذمة المالية" decoration-success="state=='approved'" decoration-danger="state=='overdue'">
        <field name="employee_id"/>
        <field name="disclosure_type"/>
        <field name="declaration_date"/>
        <field name="renewal_due_date"/>
        <field name="net_worth"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_disclosure" model="ir.actions.act_window">
    <field name="name">إقرارات الذمة المالية</field>
    <field name="res_model">demo_gov.hr.disclosure</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
