<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_eta_retry_agent" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.eta.retry.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="وكيل ETA" string="وكيل ETA" name="eta_retry_agent">
                    <block title="إعدادات وكيل ETA لإعادة المحاولة الذكية">
                        <setting string="تفعيل الوكيل">
                            <field name="eta_retry_agent_enabled"/>
                        </setting>
                        <setting string="أقصى عدد محاولات">
                            <field name="eta_retry_agent_max_attempts"/>
                        </setting>
                        <setting string="إعادة أخطاء الشبكة تلقائياً">
                            <field name="eta_retry_agent_auto_retry_network"/>
                        </setting>
                        <setting string="أساس Backoff بالساعات">
                            <field name="eta_retry_agent_backoff_base_hours"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
