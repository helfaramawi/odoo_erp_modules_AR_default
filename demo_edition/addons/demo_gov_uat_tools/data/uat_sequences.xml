<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_uat_cleanup_log" model="ir.sequence">
            <field name="name">UAT Cleanup Log Sequence</field>
            <field name="code">uat.cleanup.log</field>
            <field name="prefix">CLN-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_uat_generation_log" model="ir.sequence">
            <field name="name">UAT Generation Log Sequence</field>
            <field name="code">uat.generation.log</field>
            <field name="prefix">GEN-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
