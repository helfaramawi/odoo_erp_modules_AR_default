<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="seq_hr_performance_appraisal" model="ir.sequence">
    <field name="name">تقييم أداء - رقم متسلسل</field>
    <field name="code">demo_gov.hr.performance.appraisal</field>
    <field name="prefix">APR/%(year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_hr_performance_grievance" model="ir.sequence">
    <field name="name">تظلم أداء - رقم متسلسل</field>
    <field name="code">demo_gov.hr.performance.grievance</field>
    <field name="prefix">GRV/%(year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
