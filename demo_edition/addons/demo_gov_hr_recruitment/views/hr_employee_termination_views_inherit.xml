<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_employee_form_gov_termination_inherit" model="ir.ui.view">
    <field name="name">hr.employee.form.gov.termination.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="demo_gov_hr_employee.view_employee_form_gov_inherit"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='gov_data']/group" position="after">
        <group string="إنهاء الخدمة (عند الانطباق)">
          <field name="gov_termination_type"/>
          <field name="termination_date"/>
          <field name="termination_decision_number"/>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
