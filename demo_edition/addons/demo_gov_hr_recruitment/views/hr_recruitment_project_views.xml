<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- معرَّف قبل نموذج المشروع لأن زر الإحصائيات فيه يشير إلى هذا الـ id
       عبر %(xmlid)d، ولازم يكون موجود وقت تحليل الملف. -->
  <record id="action_hr_applicant_by_project" model="ir.actions.act_window">
    <field name="name">المتقدمون</field>
    <field name="res_model">hr.applicant</field>
    <field name="view_mode">tree,kanban,form</field>
  </record>

  <record id="view_hr_recruitment_project_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.recruitment.project.form</field>
    <field name="model">demo_gov.hr.recruitment.project</field>
    <field name="arch" type="xml">
      <form string="مشروع تعيين">
        <header>
          <button name="action_publish" string="نشر" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_start_screening" string="بدء الفرز" type="object" class="btn-primary" invisible="state != 'published'"/>
          <button name="action_start_interviews" string="بدء المقابلات" type="object" class="btn-primary" invisible="state != 'screening'"/>
          <button name="action_close" string="إغلاق" type="object" invisible="state not in ('interviewing','screening','published')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,published,screening,interviewing,closed"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="%(action_hr_applicant_by_project)d" type="action"
                    class="oe_stat_button" icon="fa-users"
                    context="{'default_recruitment_project_id': id, 'search_default_recruitment_project_id': id}">
              <field name="applicant_count" widget="statinfo" string="المتقدمون"/>
            </button>
          </div>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="job_id"/>
              <field name="department_id" readonly="1"/>
            </group>
            <group>
              <field name="planned_positions"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_recruitment_project_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.recruitment.project.list</field>
    <field name="model">demo_gov.hr.recruitment.project</field>
    <field name="arch" type="xml">
      <tree string="مشاريع التعيين" decoration-success="state=='closed'">
        <field name="name"/>
        <field name="job_id"/>
        <field name="department_id"/>
        <field name="planned_positions"/>
        <field name="applicant_count"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_recruitment_project" model="ir.actions.act_window">
    <field name="name">مشاريع التعيين</field>
    <field name="res_model">demo_gov.hr.recruitment.project</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
