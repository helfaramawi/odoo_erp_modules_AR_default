<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_form_gov_inherit" model="ir.ui.view">
    <field name="name">hr.employee.form.gov.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <notebook position="inside">
        <page string="بيانات حكومية" name="gov_data">
          <group>
            <group string="الهوية والتصنيف">
              <field name="national_id"/>
              <field name="permanent_employee_number" readonly="1"/>
              <field name="gov_employment_type"/>
              <field name="gov_entity"/>
              <field name="civil_service_grade"/>
            </group>
            <group string="قرار التعيين">
              <field name="appointment_decision_number"/>
              <field name="appointment_decision_date"/>
            </group>
          </group>
          <div class="alert alert-warning" role="alert" invisible="documents_complete">
            <strong>⚠ مستندات ناقصة: </strong>
            <field name="missing_documents" readonly="1"/>
          </div>
          <field name="document_ids">
            <tree editable="bottom">
              <field name="document_type"/>
              <field name="attachment_id"/>
              <field name="submitted_date"/>
              <field name="notes"/>
            </tree>
          </field>
        </page>
      </notebook>
    </field>
  </record>

  <record id="view_employee_tree_gov_inherit" model="ir.ui.view">
    <field name="name">hr.employee.tree.gov.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_tree"/>
    <field name="arch" type="xml">
      <tree position="inside">
        <field name="permanent_employee_number" optional="show"/>
        <field name="gov_employment_type" optional="hide"/>
      </tree>
    </field>
  </record>
</odoo>
