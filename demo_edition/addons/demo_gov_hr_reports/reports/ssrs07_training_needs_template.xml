<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_ssrs07_training_needs_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page" style="direction:rtl; font-family:'Amiri','Noto Naskh Arabic',Arial,sans-serif; padding:20px;">
          <h2 style="text-align:center;">نموذج 4 — حصر الاحتياجات التدريبية</h2>
          <h4 style="text-align:center;">SSRS-07</h4>
          <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-top:16px;">
            <tr style="background:#eee;">
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الإدارة</td>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الموظف</td>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الاحتياج التدريبي</td>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الأولوية</td>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الجهة المنفذة</td>
            </tr>
            <t t-foreach="docs" t-as="o">
              <tr>
                <td style="padding:4px; border:1px solid #999;"><t t-esc="o.department_id.name"/></td>
                <td style="padding:4px; border:1px solid #999;"><t t-esc="o.employee_id.name"/></td>
                <td style="padding:4px; border:1px solid #999;"><t t-esc="o.name"/></td>
                <td style="padding:4px; border:1px solid #999;">
                  <t t-esc="dict(o._fields['priority'].selection).get(o.priority, '')"/>
                </td>
                <td style="padding:4px; border:1px solid #999;">........................</td>
              </tr>
            </t>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
