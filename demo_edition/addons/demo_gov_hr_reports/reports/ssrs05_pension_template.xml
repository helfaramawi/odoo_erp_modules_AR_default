<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_ssrs05_pension_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
        <div class="page" style="direction:rtl; font-family:'Amiri','Noto Naskh Arabic',Arial,sans-serif; padding:20px;">
          <h2 style="text-align:center;">استمارة 15 — الهيئة القومية للتأمينات والمعاشات</h2>
          <h4 style="text-align:center;">SSRS-05</h4>
          <table style="width:100%; border-collapse:collapse; font-size:10pt; margin-top:16px;">
            <tr>
              <td style="width:30%; font-weight:bold; padding:4px; border:1px solid #999;">اسم الموظف</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.employee_id.name"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الرقم القومي</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.employee_id.national_id"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الرقم الوظيفي الثابت</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.employee_id.permanent_employee_number"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">نوع إنهاء الخدمة</td>
              <td style="padding:4px; border:1px solid #999;">
                <t t-esc="dict(o._fields['termination_type'].selection).get(o.termination_type, '')"/>
              </td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">سنوات الخدمة</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.years_of_service"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">تاريخ التسوية</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="o.settlement_date"/></td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الأجر التقاعدي الأخير</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="'%.2f' % o.final_pensionable_salary"/> جنيه</td>
            </tr>
            <tr style="font-weight:bold; background:#f5f5f5;">
              <td style="padding:4px; border:1px solid #999;">قيمة المعاش الشهري المستحق</td>
              <td style="padding:4px; border:1px solid #999;"><t t-esc="'%.2f' % o.pension_amount"/> جنيه</td>
            </tr>
            <tr>
              <td style="font-weight:bold; padding:4px; border:1px solid #999;">الحالة</td>
              <td style="padding:4px; border:1px solid #999;">
                <t t-esc="dict(o._fields['state'].selection).get(o.state, '')"/>
              </td>
            </tr>
          </table>
          <table style="width:100%; margin-top:40px; font-size:9pt;">
            <tr>
              <td style="width:33%; text-align:center;">توقيع مسؤول شؤون العاملين<br/><br/>....................</td>
              <td style="width:33%; text-align:center;">توقيع مدير الموارد البشرية<br/><br/>....................</td>
              <td style="width:33%; text-align:center;">ختم الجهة<br/><br/>....................</td>
            </tr>
          </table>
        </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
