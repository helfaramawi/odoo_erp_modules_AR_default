<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ══════════════════════════════════════════════════════════════
         مستخدمو العرض التجريبي — الديوان العام للمحافظة التجريبية
         noupdate="1" → لا يُعاد إنشاؤهم عند كل Upgrade
         بيانات صورية بالكامل — لا تُمثّل أشخاصاً حقيقيين.
         كلمة المرور تُقرأ من متغير البيئة DEMO_USERS_PASSWORD عند التزريع
         (راجع scripts/demo-seed/README.md) — القيمة أدناه افتراضية للتجربة المحلية فقط.
    ══════════════════════════════════════════════════════════════════ -->

    <!-- 1. مدير عام (تجريبي) -->
    <record id="user_director_general" model="res.users">
        <field name="name">مدير عام - حساب تجريبي</field>
        <field name="login">demo.admin</field>
        <field name="email">demo.admin@demo-gov.example</field>
        <field name="password">Demo@2024</field>
        <field name="groups_id" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_system')),
            (4, ref('l10n_eg_custody.group_custody_manager')),
            (4, ref('procurement_committee.group_contract_director')),
            (4, ref('stock_addition_permit.group_warehouse_manager')),
            (4, ref('stock_stocktaking_eg.group_stocktaking_chairman')),
            (4, ref('procurement_adjudication.group_adjudication_director')),
            (4, ref('l10n_eg_auction.group_auction_manager')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('stock.group_stock_manager')),
        ]"/>
    </record>

