<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_payroll_transaction_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.transaction.form</field>
    <field name="model">demo_gov.hr.payroll.transaction</field>
    <field name="arch" type="xml">
      <form string="حركة تأثيرات استثنائية">
        <header>
          <button name="action_execute" string="تنفيذ العملية" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_reset_to_draft" string="إرجاع لمسودة" type="object" invisible="state != 'executed'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,executed"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="reason"/>
              <field name="amount"/>
            </group>
            <group>
              <field name="days"/>
              <field name="month_days"/>
              <field name="transaction_date"/>
              <field name="decision_date"/>
            </group>
          </group>
          <field name="notes" placeholder="ملاحظات..."/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_payroll_transaction_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.transaction.list</field>
    <field name="model">demo_gov.hr.payroll.transaction</field>
    <field name="arch" type="xml">
      <tree string="حركات التأثيرات الاستثنائية" decoration-success="state=='executed'">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="reason"/>
        <field name="amount"/>
        <field name="transaction_date"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_payroll_transaction" model="ir.actions.act_window">
    <field name="name">حركات التأثيرات الاستثنائية</field>
    <field name="res_model">demo_gov.hr.payroll.transaction</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
