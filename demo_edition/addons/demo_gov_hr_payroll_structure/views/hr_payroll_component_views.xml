<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_payroll_component_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.component.form</field>
    <field name="model">demo_gov.hr.payroll.component</field>
    <field name="arch" type="xml">
      <form string="بند راتب">
        <sheet>
          <group>
            <group>
              <field name="code"/>
              <field name="name"/>
            </group>
            <group>
              <field name="component_type"/>
              <field name="computation_method"/>
              <field name="sequence"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_payroll_component_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.component.list</field>
    <field name="model">demo_gov.hr.payroll.component</field>
    <field name="arch" type="xml">
      <tree string="بنود الراتب">
        <field name="sequence" widget="handle"/>
        <field name="code"/>
        <field name="name"/>
        <field name="component_type"/>
        <field name="computation_method"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_payroll_component" model="ir.actions.act_window">
    <field name="name">بنود الراتب</field>
    <field name="res_model">demo_gov.hr.payroll.component</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
