<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_takaful_contribution_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.takaful.contribution.form</field>
    <field name="model">demo_gov.hr.takaful.contribution</field>
    <field name="arch" type="xml">
      <form string="اشتراك تكافل">
        <header>
          <button name="action_post" string="ترحيل" type="object" class="btn-primary" invisible="state == 'posted'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <field name="member_id"/>
            <field name="amount"/>
            <field name="trans_date"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_takaful_contribution_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.takaful.contribution.list</field>
    <field name="model">demo_gov.hr.takaful.contribution</field>
    <field name="arch" type="xml">
      <tree string="اشتراكات صندوق التكافل" decoration-success="state=='posted'">
        <field name="name"/>
        <field name="member_id"/>
        <field name="trans_date"/>
        <field name="amount"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_takaful_contribution" model="ir.actions.act_window">
    <field name="name">اشتراكات صندوق التكافل</field>
    <field name="res_model">demo_gov.hr.takaful.contribution</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
