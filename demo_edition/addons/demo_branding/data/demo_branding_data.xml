<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="param_application_name" model="ir.config_parameter">
        <field name="key">demo_branding.application_name</field>
        <field name="value">Enterprise Digital Operations Platform</field>
    </record>

    <record id="param_organization_name" model="ir.config_parameter">
        <field name="key">demo_branding.organization_name</field>
        <field name="value">Public Services Organization</field>
    </record>

    <record id="param_environment" model="ir.config_parameter">
        <field name="key">demo_branding.environment</field>
        <field name="value">demo</field>
