    <record id="param_support_email" model="ir.config_parameter">
        <field name="key">demo_branding.support_email</field>
        <field name="value">support@example.com</field>
    </record>

    <record id="param_support_phone" model="ir.config_parameter">
        <field name="key">demo_branding.support_phone</field>
        <field name="value">+000 000 0000</field>
    </record>

</odoo>
