<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="demo_branding_config_view_form" model="ir.ui.view">
        <field name="name">demo.branding.config.form</field>
        <field name="model">demo.branding.config</field>
        <field name="arch" type="xml">
            <form string="Demo Branding">
                <sheet>
                    <group>
                        <field name="application_name"/>
                        <field name="organization_name"/>
                        <field name="environment"/>
                        <field name="support_email"/>
                        <field name="support_phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="demo_branding_config_action" model="ir.actions.act_window">
        <field name="name">Demo Branding</field>
        <field name="res_model">demo.branding.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" eval="ref('demo_branding.default_config')"/>
    </record>

    <menuitem
        id="menu_demo_branding_config"
        name="Demo Branding"
        parent="base.menu_administration"
        action="demo_branding_config_action"
        sequence="99"
    />

</odoo>
