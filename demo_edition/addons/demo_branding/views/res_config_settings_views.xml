<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.demo.branding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Demo Branding" string="Demo Branding" data-key="demo_branding">
                    <h2>Demo Branding</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="demo_branding_application_name" string="Application Name"/>
                                <div class="text-muted">Shown on the login screen, printed reports, and dashboards</div>
                                <field name="demo_branding_application_name"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="demo_branding_organization_name" string="Organization Name"/>
                                <field name="demo_branding_organization_name"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="demo_branding_environment" string="Environment"/>
                                <div class="text-muted">"Demo" shows the DEMO ENVIRONMENT banner on the login screen</div>
                                <field name="demo_branding_environment"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="demo_branding_support_email" string="Support Email"/>
                                <field name="demo_branding_support_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="demo_branding_support_phone" string="Support Phone"/>
                                <field name="demo_branding_support_phone"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
