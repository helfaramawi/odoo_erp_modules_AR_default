<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_payroll_disbursement_line_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.disbursement.line.list</field>
    <field name="model">demo_gov.hr.payroll.disbursement.line</field>
    <field name="arch" type="xml">
      <tree string="دفتر 129 سايرة" create="false" edit="false">
        <field name="employee_id"/>
        <field name="month"/>
        <field name="year"/>
        <field name="disbursement_type"/>
        <field name="gross_amount"/>
        <field name="net_amount"/>
        <field name="source_reference"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_payroll_disbursement_line" model="ir.actions.act_window">
    <field name="name">دفتر 129 سايرة</field>
    <field name="res_model">demo_gov.hr.payroll.disbursement.line</field>
    <field name="view_mode">tree</field>
    <field name="context">{'search_default_group_employee': 1}</field>
  </record>

  <record id="view_hr_payroll_disbursement_line_search" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.disbursement.line.search</field>
    <field name="model">demo_gov.hr.payroll.disbursement.line</field>
    <field name="arch" type="xml">
      <search string="دفتر 129 سايرة">
        <field name="employee_id"/>
        <field name="year"/>
        <filter name="group_employee" string="تجميع حسب الموظف" context="{'group_by': 'employee_id'}"/>
        <filter name="group_year" string="تجميع حسب السنة" context="{'group_by': 'year'}"/>
      </search>
    </field>
  </record>

</odoo>
