<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_payroll_reward_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.reward.form</field>
    <field name="model">demo_gov.hr.payroll.reward</field>
    <field name="arch" type="xml">
      <form string="مكافأة موظف">
        <header>
          <button name="action_post" string="ترحيل لدفتر 129 سايرة" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="reward_reason"/>
              <field name="date"/>
            </group>
            <group>
              <field name="amount"/>
              <field name="insurance_deduction"/>
              <field name="tax_deduction"/>
              <field name="net_amount" readonly="1"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_payroll_reward_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.reward.list</field>
    <field name="model">demo_gov.hr.payroll.reward</field>
    <field name="arch" type="xml">
      <tree string="مكافآت الموظفين" decoration-success="state=='posted'">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="date"/>
        <field name="amount"/>
        <field name="net_amount"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_payroll_reward" model="ir.actions.act_window">
    <field name="name">مكافآت الموظفين</field>
    <field name="res_model">demo_gov.hr.payroll.reward</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
