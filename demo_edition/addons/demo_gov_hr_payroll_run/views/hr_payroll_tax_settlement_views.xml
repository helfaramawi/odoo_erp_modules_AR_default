<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_payroll_tax_settlement_form" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.tax.settlement.form</field>
    <field name="model">demo_gov.hr.payroll.tax.settlement</field>
    <field name="arch" type="xml">
      <form string="تسوية ضريبية سنوية">
        <header>
          <button name="action_compute" string="حساب التسوية" type="object" class="btn-primary" invisible="state == 'finalized'"/>
          <button name="action_finalize" string="اعتماد نهائي" type="object" class="btn-success" invisible="state != 'computed'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,computed,finalized"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="employee_id"/></h1></div>
          <group>
            <field name="fiscal_year"/>
          </group>
          <group>
            <group>
              <field name="annual_gross_income" readonly="1"/>
              <field name="total_tax_withheld" readonly="1"/>
            </group>
            <group>
              <field name="total_tax_due" readonly="1"/>
              <field name="adjustment_amount" readonly="1"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_payroll_tax_settlement_list" model="ir.ui.view">
    <field name="name">demo_gov.hr.payroll.tax.settlement.list</field>
    <field name="model">demo_gov.hr.payroll.tax.settlement</field>
    <field name="arch" type="xml">
      <tree string="التسويات الضريبية السنوية" decoration-success="state=='finalized'">
        <field name="employee_id"/>
        <field name="fiscal_year"/>
        <field name="annual_gross_income"/>
        <field name="total_tax_withheld"/>
        <field name="total_tax_due"/>
        <field name="adjustment_amount"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="action_hr_payroll_tax_settlement" model="ir.actions.act_window">
    <field name="name">التسوية الضريبية السنوية</field>
    <field name="res_model">demo_gov.hr.payroll.tax.settlement</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
