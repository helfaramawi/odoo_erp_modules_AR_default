<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="seq_hr_payroll_reward" model="ir.sequence">
    <field name="name">مكافأة موظف - رقم متسلسل</field>
    <field name="code">demo_gov.hr.payroll.reward</field>
    <field name="prefix">RWD/%(year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_hr_payroll_non_employee_reward" model="ir.sequence">
    <field name="name">مكافأة غير عامل - رقم متسلسل</field>
    <field name="code">demo_gov.hr.payroll.non.employee.reward</field>
    <field name="prefix">NRW/%(year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_hr_payroll_allowance_increment" model="ir.sequence">
    <field name="name">حركة علاوة - رقم متسلسل</field>
    <field name="code">demo_gov.hr.payroll.allowance.increment</field>
    <field name="prefix">ALW/%(year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
