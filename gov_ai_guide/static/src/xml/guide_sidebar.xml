<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gov_ai_guide.GovAISidebar">
        <div t-att-class="'gov-ai-sidebar ' + (state.expanded ? 'expanded' : 'collapsed')"
             dir="rtl">

            <!-- رأسية الشريط -->
            <div class="gov-sidebar-header">
                <div class="gov-logo">
                    <svg viewBox="0 0 40 40" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="20" r="18" fill="#c8a84b" stroke="#1a2744" stroke-width="2"/>
                        <text x="50%" y="55%" text-anchor="middle"
                              dominant-baseline="middle"
                              font-size="16" fill="#1a2744" font-weight="bold">م</text>
                    </svg>
                </div>

                <t t-if="state.expanded">
                    <span class="gov-title">المرشد الحكومي</span>
                    <span t-att-class="'gov-dot ' + (agentState.isConnected ? 'connected' : 'disconnected')"/>
                </t>

                <button class="gov-toggle-btn" t-on-click="toggleSidebar">
                    <t t-if="state.expanded">&#x25C4;</t>
                    <t t-else="">&#x25BA;</t>
                </button>
            </div>

            <!-- محتوى الشريط — مرئي فقط عند التوسع -->
            <t t-if="state.expanded">

                <!-- الحقل الحالي -->
                <div class="gov-field-info">
                    <span class="gov-field-label">الحقل: </span>
                    <span class="gov-field-name" t-esc="fieldLabel"/>
                </div>

                <!-- منطقة التلميح -->
                <div class="gov-hint-area">

                    <t t-if="showLoader">
                        <div class="gov-loading">
                            <div class="gov-loading-dots">
                                <span/><span/><span/>
                            </div>
                            <span class="gov-loading-text">جارٍ تحليل الحقل...</span>
                        </div>
                    </t>

                    <t t-elif="agentState.lastError">
                        <div class="gov-error-msg" t-esc="agentState.lastError"/>
                    </t>

                    <t t-elif="agentState.currentHint">
                        <!-- مراجع قانونية -->
                        <t t-if="state.parsed.lawRefs.length">
                            <div class="gov-law-refs">
                                <t t-foreach="state.parsed.lawRefs" t-as="ref" t-key="ref">
                                    <span class="gov-law-badge-header" t-esc="ref"/>
                                </t>
                            </div>
                        </t>

                        <!-- نص الإرشاد -->
                        <div class="gov-hint-text">
                            <t t-out="renderedHint"/>
                            <t t-if="agentState.isStreaming">
                                <span class="gov-cursor-blink">|</span>
                            </t>
                        </div>

                        <!-- زر النسخ -->
                        <t t-if="!agentState.isStreaming">
                            <div class="gov-actions">
                                <button class="gov-btn-copy" t-on-click="copyHint">
                                    <t t-if="state.copyOk">تم النسخ</t>
                                    <t t-else="">نسخ النص</t>
                                </button>
                            </div>
                        </t>
                    </t>

                    <t t-else="">
                        <div class="gov-welcome">
                            <p>انقر على أي حقل في النموذج لتلقي الإرشاد الحكومي المناسب</p>
                        </div>
                    </t>
                </div>

                <!-- سؤال متابعة -->
                <t t-if="agentState.currentHint and !agentState.isLoading">
                    <div class="gov-followup">
                        <input type="text"
                               class="gov-followup-input"
                               placeholder="سؤال متابعة..."
                               t-model="state.followupText"
                               t-on-keydown="onFollowupKey"
                               dir="rtl"/>
                        <button class="gov-followup-btn"
                                t-on-click="sendFollowup">إرسال</button>
                    </div>
                </t>

                <!-- تذييل -->
                <div class="gov-footer">
                    <span>المرشد الحكومي الذكي</span>
                </div>

            </t>

            <!-- أيقونة في وضع الطي -->
            <t t-else="">
                <div class="gov-collapsed-icon" t-on-click="toggleSidebar" title="المرشد الحكومي">
                    &#x1F3DB;
                </div>
            </t>

        </div>
    </t>

</templates>
