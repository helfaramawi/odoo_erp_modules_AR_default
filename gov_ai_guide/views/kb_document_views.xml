<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         عرض قائمة وثائق قاعدة المعرفة
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_kb_document_list" model="ir.ui.view">
        <field name="name">gov.kb.document.list</field>
        <field name="model">gov.kb.document</field>
        <field name="arch" type="xml">
            <tree string="وثائق قاعدة المعرفة"
                  decoration-muted="not active"
                  default_order="create_date desc">
                <field name="name" string="اسم الوثيقة"/>
                <field name="source_type" string="النوع" widget="badge"
                       decoration-info="source_type == 'addon_source'"
                       decoration-success="source_type == 'legal_pdf'"
                       decoration-warning="source_type == 'ministerial_decree'"
                       decoration-primary="source_type == 'accounting_standard'"/>
                <field name="module_name" string="الوحدة"/>
                <field name="law_number" string="رقم القانون"/>
                <field name="authority" string="الجهة المصدِرة"/>
                <field name="chunk_index" string="رقم القطعة"/>
                <field name="tokens_count" string="الكلمات (تقريباً)"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         عرض نموذج وثيقة قاعدة المعرفة
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_kb_document_form" model="ir.ui.view">
        <field name="name">gov.kb.document.form</field>
        <field name="model">gov.kb.document</field>
        <field name="arch" type="xml">
            <form string="وثيقة قاعدة المعرفة">
                <header>
                    <!-- زر الفهرسة الفورية -->
                    <button name="action_index_now"
                            string="فهرسة الآن"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('source_type', '=', 'addon_source')]}"
                            icon="fa-database"/>
                    <button name="action_reindex_all_addons"
                            string="إعادة فهرسة جميع الـ Addons"
                            type="object"
                            class="btn-secondary"
                            groups="base.group_system"
                            confirm="ستتم إعادة فهرسة جميع الـ addons المثبتة. قد تستغرق هذه العملية بعض الوقت. هل تريد المتابعة؟"/>
                    <field name="active" widget="boolean_button"
                           options="{'terminology': {
                               'string_true': 'نشط',
                               'string_false': 'معطّل',
                               'hover_true': 'تعطيل',
                               'hover_false': 'تفعيل'
                           }}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="اسم الوثيقة / القانون..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="معلومات المصدر">
                            <field name="source_type" widget="radio"/>
                            <field name="source_file" readonly="1"
                                   attrs="{'invisible': [('source_type', '!=', 'addon_source')]}"/>
                        </group>
                        <group string="معلومات قانونية">
                            <field name="law_number"/>
                            <field name="law_date"/>
                            <field name="authority"/>
                        </group>
                    </group>
                    <group>
                        <group string="الربط بالنظام">
                            <field name="module_name"/>
                            <field name="model_name"/>
                            <field name="field_names"/>
                        </group>
                        <group string="إحصائيات">
                            <field name="chunk_index" readonly="1"/>
                            <field name="tokens_count" readonly="1"/>
                            <field name="embedding_model" readonly="1"/>
                        </group>
                    </group>

                    <!-- رفع ملف PDF -->
                    <group string="ملف الوثيقة"
                           attrs="{'invisible': [('source_type', '=', 'addon_source')]}">
                        <field name="pdf_file" widget="binary" filename="pdf_filename"/>
                        <field name="pdf_filename" invisible="1"/>
                    </group>

                    <!-- محتوى الوثيقة المستخرج -->
                    <notebook>
                        <page string="المحتوى المستخرج">
                            <field name="content"
                                   widget="text"
                                   attrs="{'readonly': [('source_type', '=', 'addon_source')]}"
                                   placeholder="سيُملأ هذا الحقل تلقائياً عند الفهرسة..."
                                   style="font-family: Cairo, Arial, sans-serif; font-size: 14px; direction: rtl; min-height: 300px;"/>
                        </page>
                        <page string="المتجه الدلالي" groups="base.group_system">
                            <div class="alert alert-info" role="alert">
                                المتجه الدلالي (Embedding) يُحسَب تلقائياً ويُخزَّن بصيغة JSON.
                                طوله يُشير لدقة نموذج التضمين المستخدم.
                            </div>
                            <field name="embedding" readonly="1" widget="text"
                                   style="font-family: monospace; font-size: 11px; max-height: 200px; overflow: auto;"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         عرض بحث مع فلاتر
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_kb_document_search" model="ir.ui.view">
        <field name="name">gov.kb.document.search</field>
        <field name="model">gov.kb.document</field>
        <field name="arch" type="xml">
            <search string="البحث في قاعدة المعرفة">
                <field name="name" string="الاسم"/>
                <field name="law_number" string="رقم القانون"/>
                <field name="authority" string="الجهة المصدِرة"/>
                <field name="module_name" string="الوحدة"/>
                <field name="content" string="المحتوى"/>

                <!-- فلاتر النوع -->
                <filter string="كود المصدر" name="addon_source"
                        domain="[('source_type','=','addon_source')]"/>
                <filter string="وثائق قانونية" name="legal_pdf"
                        domain="[('source_type','=','legal_pdf')]"/>
                <filter string="قرارات وزارية" name="ministerial_decree"
                        domain="[('source_type','=','ministerial_decree')]"/>
                <filter string="معايير محاسبية" name="accounting_standard"
                        domain="[('source_type','=','accounting_standard')]"/>
                <separator/>
                <filter string="نشط" name="active" domain="[('active','=',True)]"/>
                <filter string="معطّل" name="inactive" domain="[('active','=',False)]"/>

                <!-- تجميع -->
                <group expand="0" string="تجميع حسب">
                    <filter string="الوحدة" name="by_module"
                            context="{'group_by': 'module_name'}"/>
                    <filter string="النوع" name="by_type"
                            context="{'group_by': 'source_type'}"/>
                    <filter string="الجهة المصدِرة" name="by_authority"
                            context="{'group_by': 'authority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         عرض قائمة سجل التلميحات
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_agent_log_list" model="ir.ui.view">
        <field name="name">gov.agent.log.list</field>
        <field name="model">gov.agent.log</field>
        <field name="arch" type="xml">
            <tree string="سجل التلميحات" default_order="timestamp desc" create="false">
                <field name="timestamp" string="الوقت"/>
                <field name="user_id" string="المستخدم"/>
                <field name="model_name" string="النموذج"/>
                <field name="field_name" string="الحقل"/>
                <field name="tokens_used" string="الرموز"/>
                <field name="response_ms" string="زمن الاستجابة (ms)"/>
                <field name="was_cached" string="من الـ Cache" widget="boolean"/>
                <field name="fallback_used" string="استُخدم الاحتياطي" widget="boolean"/>
            </tree>
        </field>
    </record>

    <!-- عرض نموذج سجل التلميحات -->
    <record id="view_agent_log_form" model="ir.ui.view">
        <field name="name">gov.agent.log.form</field>
        <field name="model">gov.agent.log</field>
        <field name="arch" type="xml">
            <form string="سجل التلميح" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="معلومات الجلسة">
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="timestamp"/>
                        </group>
                        <group string="سياق الحقل">
                            <field name="model_name"/>
                            <field name="field_name"/>
                            <field name="field_value"/>
                        </group>
                    </group>
                    <group>
                        <group string="أداء الاستجابة">
                            <field name="tokens_used"/>
                            <field name="response_ms"/>
                            <field name="was_cached"/>
                            <field name="fallback_used"/>
                        </group>
                    </group>
                    <group string="نص التلميح">
                        <field name="hint_text" nolabel="1" readonly="1"
                               style="font-family: Cairo, Arial; direction: rtl; line-height: 1.8;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         إجراء خادم: إعادة فهرسة جميع الـ Addons
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_reindex_all" model="ir.actions.server">
        <field name="name">إعادة فهرسة جميع الـ Addons</field>
        <field name="model_id" ref="gov_ai_guide.model_gov_kb_document"/>
        <field name="binding_model_id" ref="gov_ai_guide.model_gov_kb_document"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
env['gov.kb.document'].action_reindex_all_addons()
        </field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Actions لفتح العروض
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_kb_documents" model="ir.actions.act_window">
        <field name="name">قاعدة المعرفة</field>
        <field name="res_model">gov.kb.document</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_kb_document_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                قاعدة المعرفة فارغة
            </p>
            <p>
                أضف وثائق قانونية أو قم بتشغيل "إعادة فهرسة جميع الـ Addons"
                لملء قاعدة المعرفة تلقائياً.
            </p>
        </field>
    </record>

    <record id="action_agent_logs" model="ir.actions.act_window">
        <field name="name">سجل التلميحات</field>
        <field name="res_model">gov.agent.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا توجد تلميحات مسجّلة بعد
            </p>
        </field>
    </record>

    <record id="action_agent_sessions" model="ir.actions.act_window">
        <field name="name">جلسات المرشد</field>
        <field name="res_model">gov.agent.session</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
